<!-- ReportWindow.xaml -->
<Window x:Class="HVACLoadTerminals.CreateParameters.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Отчет о создании параметров" Height="450" Width="600"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer>
        <ItemsControl x:Name="ReportItemsControl" Margin="10">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Expander Header="{Binding CreatorName}" Margin="0 5" IsExpanded="True">
                        <StackPanel Margin="10 5">
                            <TextBlock Text="{Binding ParametersSummary}" FontWeight="Bold"/>
                            <TextBlock Text="Параметры:" Margin="0 5 0 0"/>
                            <ItemsControl ItemsSource="{Binding Parameters}" Margin="10 0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Категории:" Margin="0 5 0 0"/>
                            <ItemsControl ItemsSource="{Binding Categories}" Margin="10 0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</Window>