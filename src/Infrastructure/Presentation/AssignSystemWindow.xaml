<Window x:Class="HVACLoadTerminals.Infrastructure.Presentation.AssignSystemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Назначить систему помещениям"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F4F6F9"
        TextElement.Foreground="#24292f">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#57606a"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Система -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Тип системы:"/>
        <ComboBox x:Name="CmbType" Grid.Row="0" Grid.Column="1"
                  SelectionChanged="CmbType_SelectionChanged"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Название системы:"/>
        <TextBox x:Name="TxtName" Grid.Row="1" Grid.Column="1"/>

        <!-- Прибор -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Производитель:"/>
        <ComboBox x:Name="CmbManufacturer" Grid.Row="2" Grid.Column="1"
                  SelectionChanged="CmbManufacturer_SelectionChanged"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Типоразмер:"/>
        <ComboBox x:Name="CmbDevice" Grid.Row="3" Grid.Column="1"/>

        <!-- Опции установки -->
        <TextBlock Grid.Row="4" Grid.Column="0" Text="Расход, м³/ч:"/>
        <TextBox x:Name="TxtFlow" Grid.Row="4" Grid.Column="1"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Правило количества:"/>
        <ComboBox x:Name="CmbRule" Grid.Row="5" Grid.Column="1"
                  SelectionChanged="CmbRule_SelectionChanged"/>

        <TextBlock x:Name="LblFixedCount" Grid.Row="6" Grid.Column="0"
                   Text="N (фиксированное):"
                   Visibility="Collapsed"/>
        <TextBox x:Name="TxtFixedCount" Grid.Row="6" Grid.Column="1"
                 Text="1" Visibility="Collapsed"/>

        <TextBlock Grid.Row="7" Grid.Column="0" Text="Паттерн расстановки:"/>
        <ComboBox x:Name="CmbPattern" Grid.Row="7" Grid.Column="1"/>

        <CheckBox x:Name="ChkReplace" Grid.Row="8" Grid.Column="1"
                  Content="Заменить другие системы этого типа в помещении"
                  Margin="0,8,0,2" FontSize="12"/>

        <!-- Ошибки + кнопки -->
        <TextBlock x:Name="ErrorText" Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2"
                   Foreground="#cf222e" TextWrapping="Wrap" Margin="0,8,0,0"
                   Visibility="Collapsed"/>

        <Border Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2"
                BorderBrush="#d0d7de" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="ОК" Click="Ok_Click" FontWeight="SemiBold"
                        Background="#2D6CDF" Foreground="White"
                        BorderBrush="#1B4FA8"/>
                <Button Content="Отмена" Click="Cancel_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
