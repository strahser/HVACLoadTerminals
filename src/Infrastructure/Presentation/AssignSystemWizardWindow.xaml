<Window x:Class="HVACLoadTerminals.Infrastructure.Presentation.AssignSystemWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="Назначение системы — мастер v2.1 (таблица+стена N=1)"
        Height="680" Width="1080"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F9">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2D6CDF"/>
        <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#1B4FA8"/>
        <SolidColorBrush x:Key="PanelBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#D5DBE3"/>
        <SolidColorBrush x:Key="TextDark" Color="#212B36"/>
        <SolidColorBrush x:Key="TextMuted" Color="#637381"/>
        <Style x:Key="StepHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryDarkBrush}"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EDF2FC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryDarkBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryDarkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Шапка -->
        <Border DockPanel.Dock="Top" Background="#1F2A44" Padding="14,8">
            <StackPanel>
                <TextBlock Text="Назначение системы помещениям" FontSize="15" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Тип → Класс оборудования → Производитель → Марка → Расчёт и геометрия. Слева шаги, справа — превью на первом выбранном помещении." FontSize="11" Foreground="#AEBBD4" TextWrapping="Wrap" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Низ: ошибки + кнопки -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,7">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Отмена" Click="Cancel_Click"/>
                    <Button Content="✔ Применить и добавить ещё" Click="ApplyAnother_Click"
                            ToolTip="Назначить систему и остаться в мастере — можно назначить следующий тип"/>
                    <Button Content="Готово" Style="{StaticResource PrimaryButton}" Click="Ok_Click"/>
                </StackPanel>
                <TextBlock x:Name="ErrorText" Foreground="#C0392B" FontSize="11" TextWrapping="Wrap"
                           VerticalAlignment="Center" Visibility="Collapsed"/>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- Сводка контекста (RW11): что уже назначено -->
            <Border Grid.Row="0" Grid.ColumnSpan="3" Background="#FFF7E6" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1" Padding="12,5">
                <TextBlock x:Name="ExistingText" FontSize="11" Foreground="{StaticResource TextDark}" TextWrapping="Wrap"
                           Text="Выберите помещения в таблице."/>
            </Border>

            <!-- Шаги -->
            <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12,6,6,10">
                    <TextBlock Style="{StaticResource StepHeader}">1 · ТИП СИСТЕМЫ</TextBlock>
                    <ComboBox x:Name="CmbType" SelectionChanged="Type_Changed" Height="30" FontSize="13"/>

                    <TextBlock Style="{StaticResource StepHeader}">2 · КЛАСС ОБОРУДОВАНИЯ</TextBlock>
                    <ComboBox x:Name="CmbFamily" SelectionChanged="Family_Changed" Height="28"/>

                    <TextBlock Style="{StaticResource StepHeader}">3 · ПРОИЗВОДИТЕЛЬ</TextBlock>
                    <ComboBox x:Name="CmbManufacturer" SelectionChanged="Manufacturer_Changed" Height="28"/>

                    <TextBlock Style="{StaticResource StepHeader}">4 · МАРКА (ТИПОРАЗМЕР)</TextBlock>
                    <ComboBox x:Name="CmbDevice" SelectionChanged="Device_Changed" Height="28"/>
                    <TextBlock x:Name="DeviceInfoText" FontSize="11" Foreground="{StaticResource TextMuted}"
                               TextWrapping="Wrap" Margin="0,4,0,0"/>

                    <TextBlock Style="{StaticResource StepHeader}">5 · РАСЧЁТ И ГЕОМЕТРИЯ УСТАНОВКИ</TextBlock>
                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Название системы:"/>
                        <TextBox Grid.Column="1" x:Name="TxtName" Padding="4,3" TextChanged="Preview_Changed"/>
                        <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Расход на помещение:"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtFlow" Padding="4,3" TextChanged="Preview_Changed"/>
                        <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Правило количества:"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                            <ComboBox x:Name="CmbRule" Width="160" SelectionChanged="Rule_Changed"/>
                            <TextBlock Text="N=" VerticalAlignment="Center" Margin="8,0,2,0" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TxtFixedCount" Width="46" Padding="4,3" TextChanged="Preview_Changed"/>
                        </StackPanel>
                        <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="Геометрия установки:"/>
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                            <ComboBox x:Name="CmbPattern" Width="170" SelectionChanged="Pattern_Changed"/>
                            <ComboBox x:Name="CmbSingleRule" Width="130" Margin="6,0,0,0" SelectionChanged="Pattern_Changed"/>
                        </StackPanel>
                        <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="Отступ от стены, мм:"/>
                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="TxtEdgeOffset" Padding="4,3" TextChanged="Preview_Changed"
                                 ToolTip="Пусто = по типоразмеру/умолчанию; перекрывает каталог"/>
                        <TextBlock Grid.Row="5" Style="{StaticResource FieldLabel}" Text="Привязка к стене:"/>
                        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ComboBox x:Name="CmbWall" Width="180" SelectionChanged="Wall_Changed" ToolTip="Для 1 помещения: Авто или Стена 1..n (как в Плане помещения)"/>
                            <TextBox x:Name="TxtWallOffset" Width="60" Margin="6,0,0,0" Padding="4,3" TextChanged="Preview_Changed" ToolTip="Смещение от стены, мм (пусто=как Отступ)"/>
                        </StackPanel>
                        <TextBlock Grid.Row="6" Style="{StaticResource FieldLabel}" Text=""/>
                        <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox x:Name="ChkReplace" Content="заменить однотипные в выбранных помещениях" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Row="1" Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent"/>

            <!-- Превью -->
            <Border Grid.Row="1" Grid.Column="2" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="6" Margin="6,8,10,10">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Foreground="{StaticResource TextDark}"
                               Text="Превью — первое выбранное помещение" Margin="2,2,2,6"/>
                    <DockPanel DockPanel.Dock="Top" Margin="2,0,2,4">
                        <Button DockPanel.Dock="Right" Content="⟳ Пересчитать" Click="Recalc_Click" ToolTip="Пересчитать превью и сводку" Padding="8,4"/>
                        <TextBlock Text="Сводка расчёта:" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                    </DockPanel>
                    <DataGrid x:Name="SummaryGrid" DockPanel.Dock="Top" Height="95" Margin="2,0,2,6" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" FontSize="11" Background="White" BorderBrush="{StaticResource BorderBrush}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Система" Binding="{Binding SystemName}" Width="80"/>
                            <DataGridTextColumn Header="Σ расход" Binding="{Binding TotalFlowText}" Width="80"/>
                            <DataGridTextColumn Header="N" Binding="{Binding CountText}" Width="45"/>
                            <DataGridTextColumn Header="Марка" Binding="{Binding DeviceText}" Width="*"/>
                            <DataGridTextColumn Header="k_ef" Binding="{Binding KefText}" Width="55"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock DockPanel.Dock="Bottom" x:Name="PreviewInfoText" FontSize="11"
                               Foreground="{StaticResource PrimaryDarkBrush}" TextWrapping="Wrap" Margin="2,6,2,0"/>
                    <ScottPlot:WpfPlot x:Name="PreviewPlot" Background="White"/>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
