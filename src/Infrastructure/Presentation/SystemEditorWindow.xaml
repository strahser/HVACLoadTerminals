<Window x:Class="HVACLoadTerminals.Infrastructure.Presentation.SystemEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:HVACLoadTerminals.Core.Models;assembly=HVACLoadTerminals.Core"
        Title="Системы помещения"
        Width="560" Height="420"
        WindowStartupLocation="CenterOwner"
        Background="#0d1117">
    <Window.Resources>
        <x:Array x:Key="SystemTypes" Type="{x:Type core:HVACSystemType}">
            <core:HVACSystemType>Supply</core:HVACSystemType>
            <core:HVACSystemType>Exhaust</core:HVACSystemType>
        </x:Array>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#161b22"/>
            <Setter Property="Foreground" Value="#e6edf3"/>
            <Setter Property="BorderBrush" Value="#30363d"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="AddSupplyBtn" Click="AddSupply_Click">＋ Приток</Button>
            <Button x:Name="AddExhaustBtn" Click="AddExhaust_Click">＋ Вытяжка</Button>
            <Button x:Name="RemoveBtn" Click="Remove_Click">− Удалить</Button>
        </StackPanel>
        <DataGrid x:Name="Grid" DockPanel.Dock="Top" Height="220"
                  ItemsSource="{Binding Systems}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Имя" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                <DataGridComboBoxColumn Header="Тип"
                                        SelectedItemBinding="{Binding Type}"
                                        ItemsSource="{StaticResource SystemTypes}"
                                        Width="110"/>
                <DataGridTextColumn Header="Расход, м³/ч" Binding="{Binding FlowM3h, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                <DataGridCheckBoxColumn Header="Включено" Binding="{Binding IsIncluded, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="ОК" Click="Ok_Click" FontWeight="SemiBold" Padding="18,4"/>
            <Button Content="Отмена" Click="Cancel_Click"/>
            <TextBlock x:Name="BalanceText" VerticalAlignment="Center" Margin="16,0,0,0"
                       Foreground="#9aa4ad"/>
        </StackPanel>
    </DockPanel>
</Window>
