<Window x:Class="HVACLoadTerminals.App.Views.HtmlPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HVAC Load Terminals — HTML Preview"
        Height="700" Width="1024" MinWidth="800"
        Background="#111111"
        WindowStartupLocation="CenterOwner">

    <DockPanel>
        <!-- Top Toolbar -->
        <Border DockPanel.Dock="Top"
                Background="#1E1E1E"
                Padding="8,6">
            <StackPanel Orientation="Horizontal">
            <Button x:Name="RecomputeButton"
                    Content="Recompute"
                    Padding="14,6" Margin="4"
                    Cursor="Hand"
                    Click="Recompute_Click"/>
            <Button x:Name="ApplyButton"
                    Content="Apply"
                    Padding="14,6" Margin="4"
                    Cursor="Hand"
                    Click="Apply_Click"/>
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    Padding="14,6" Margin="4"
                    Cursor="Hand"
                    Click="Cancel_Click"/>
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0"
                       Foreground="#888888"
                       FontSize="12"/>
            </StackPanel>
        </Border>

        <!-- HTML Preview Browser -->
        <WebBrowser x:Name="PreviewBrowser"/>
    </DockPanel>
</Window>
