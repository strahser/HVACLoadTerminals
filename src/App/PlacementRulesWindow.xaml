<Window x:Class="HVACLoadTerminals.App.PlacementRulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        Title="Правила размещения — глобальные настройки"
        Height="640" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F9">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2D6CDF"/>
        <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#1B4FA8"/>
        <SolidColorBrush x:Key="PanelBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#D5DBE3"/>
        <SolidColorBrush x:Key="TextDark" Color="#212B36"/>
        <SolidColorBrush x:Key="TextMuted" Color="#637381"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EDF2FC"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryDarkBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryDarkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#1F2A44" Padding="14,6">
            <StackPanel>
                <TextBlock Text="Правила размещения" FontSize="14" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Глобальные настройки по умолчанию — сохраняются в пользовательском профиле (%AppData%\ui-settings.json) и применяются к новым проектам" FontSize="11" Foreground="#AEBBD4" TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="8,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Сброс" Click="Reset_Click" ToolTip="Сбросить к заводским (0.6, Auto/ByFlow, Long/Short, Center, 2.0 м/с)"/>
                    <Button Content="Отмена" Click="Cancel_Click"/>
                    <Button Content="Применить" Style="{StaticResource PrimaryButton}" Click="Apply_Click"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" FontSize="11"/>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Margin="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,6">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Отопление — доля от окна"/>
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="55"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="RatioSlider" Minimum="0.3" Maximum="1.0" SmallChange="0.05" LargeChange="0.1" TickFrequency="0.1" IsSnapToTickEnabled="False" ValueChanged="RatioSlider_ValueChanged"/>
                            <TextBox Grid.Column="1" x:Name="RatioBox" Margin="6,0,0,0" Padding="4,2" VerticalContentAlignment="Center" TextChanged="RatioBox_TextChanged"/>
                        </Grid>
                        <TextBlock Text="Минимальная суммарная длина приборов ≥ доли ширины окна (СП, практика 60%)" Foreground="{StaticResource TextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0"/>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Приток — количество"/>
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Правило:"/>
                            <ComboBox Grid.Column="1" x:Name="SupplyRuleCombo" SelectionChanged="SupplyRule_Changed"/>
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="N фикс:"/>
                            <TextBox x:Name="FixedBox" Grid.Column="1" Padding="4,2" VerticalContentAlignment="Center" TextChanged="FixedBox_TextChanged"/>
                            <TextBlock Grid.Column="2" Text="(при Fixed)" Foreground="{StaticResource TextMuted}" FontSize="10" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </Grid>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Паттерны"/>
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Приток:"/>
                            <ComboBox Grid.Column="1" x:Name="SupplyPatternCombo" SelectionChanged="Pattern_Changed"/>
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Вытяжка:"/>
                            <ComboBox Grid.Column="1" x:Name="ExhaustPatternCombo" SelectionChanged="Pattern_Changed"/>
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Правило вытяжки:"/>
                            <ComboBox Grid.Column="1" x:Name="ExhaustRuleCombo" SelectionChanged="ExhaustRule_Changed"/>
                        </Grid>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Одиночный прибор"/>
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Размещение:"/>
                            <ComboBox Grid.Column="1" x:Name="SingleRuleCombo" SelectionChanged="SingleRule_Changed"/>
                        </Grid>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Решётки"/>
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="v, м/с:"/>
                            <Slider Grid.Column="1" x:Name="VelocitySlider" Minimum="0.5" Maximum="5.0" SmallChange="0.1" LargeChange="0.5" ValueChanged="VelocitySlider_ValueChanged"/>
                            <TextBox Grid.Column="2" x:Name="VelocityBox" Margin="6,0,0,0" Padding="4,2" VerticalContentAlignment="Center" TextChanged="VelocityBox_TextChanged"/>
                        </Grid>
                        <TextBlock Text="Скорость в живом сечении решётки (расчёт A=L/(3600·v))" Foreground="{StaticResource TextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0"/>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Отопление — зазоры"/>
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="От стены, мм:"/>
                            <TextBox Grid.Column="1" x:Name="HeatingWallBox" Padding="4,2" TextChanged="HeatingBox_TextChanged"/>
                            <TextBlock Grid.Column="2" Style="{StaticResource FieldLabel}" Text="Высота, мм:" Margin="6,0,0,0"/>
                            <TextBox Grid.Column="3" x:Name="HeatingMountBox" Padding="4,2" TextChanged="HeatingBox_TextChanged"/>
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Край, мм:"/>
                            <TextBox Grid.Column="1" x:Name="HeatingEdgeBox" Padding="4,2" TextChanged="HeatingBox_TextChanged"/>
                        </Grid>

                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,12,0,8"/>
                        <TextBlock Text="Профили" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="💾 Сохранить профиль" Click="SaveProfile_Click"/>
                            <Button Content="📂 Загрузить" Click="LoadProfile_Click"/>
                            <Button Content="🗑 Удалить" Click="DeleteProfile_Click"/>
                        </StackPanel>
                        <ComboBox x:Name="ProfileCombo" Margin="0,6,0,0" ToolTip="Сохранённые профили размещения (JSON в %AppData%\HVACLoadTerminals\placement-profiles\)"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,8,8,8">
                <DockPanel Margin="6">
                    <TextBlock DockPanel.Dock="Top" Text="Предпросмотр — типовая комната 10×6м, 3 прибора притока" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" Margin="4,4,4,6"/>
                    <oxy:PlotView x:Name="PreviewPlot" Model="{Binding PreviewModel}"/>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
