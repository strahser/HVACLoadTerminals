<Window x:Class="HVACLoadTerminals.App.MassApplyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Применить к выбранным помещениям"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F4F6F9">
    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="150"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="70"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="12">
        <TextBlock Text="Поля с чекбоксом будут записаны во все системы выбранных помещений (аналог Detail View прототипа)."
                   TextWrapping="Wrap" FontSize="11" Foreground="#637381" Margin="0,0,0,10"/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Система:" FontWeight="SemiBold"/>
            <ComboBox ItemsSource="{Binding SystemNames}"
                      SelectedItem="{Binding SelectedSystemName}" MinWidth="170"/>
        </StackPanel>

        <Separator Margin="0,0,0,8"/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <CheckBox IsChecked="{Binding SetDevice}"/>
            <TextBlock Text="Типоразмер:" Width="120"/>
            <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                      DisplayMemberPath="Label" MinWidth="300"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <CheckBox IsChecked="{Binding SetRule}"/>
            <TextBlock Text="Правило количества:" Width="120"/>
            <ComboBox ItemsSource="{Binding Rules}" SelectedItem="{Binding Rule}" Width="110"/>
            <CheckBox IsChecked="{Binding SetFixedCount}" Margin="14,0,8,0"/>
            <TextBlock Text="N="/>
            <TextBox Text="{Binding FixedCount}"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <CheckBox IsChecked="{Binding SetPattern}"/>
            <TextBlock Text="Паттерн:" Width="120"/>
            <ComboBox ItemsSource="{Binding Patterns}" SelectedItem="{Binding Pattern}" Width="110"/>
            <CheckBox IsChecked="{Binding SetSingleRule}" Margin="14,0,8,0"/>
            <TextBlock Text="1 прибор:"/>
            <ComboBox ItemsSource="{Binding SingleRules}" SelectedItem="{Binding SinglePlacementRule}" Width="90"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <CheckBox IsChecked="{Binding SetEdgeOffset}"/>
            <TextBlock Text="Отступ от стен, мм:" Width="140"/>
            <TextBox Text="{Binding EdgeOffsetMm}"/>
            <CheckBox IsChecked="{Binding SetCeilingOffset}" Margin="14,0,8,0"/>
            <TextBlock Text="Заглубление от потолка, мм:"/>
            <TextBox Text="{Binding CeilingOffsetMm}" Width="60"/>
        </StackPanel>

        <Separator Margin="0,4,0,10"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="✓ Применить и пересчитать" Command="{Binding ApplyCommand}"
                    FontWeight="SemiBold" Padding="14,6"/>
            <Button Content="Отмена" IsCancel="True" Padding="14,6" Margin="8,0,0,0"/>
        </StackPanel>
    </StackPanel>
</Window>
