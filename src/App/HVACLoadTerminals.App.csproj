<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>HVACLoadTerminals.App</RootNamespace>
    <AssemblyName>HVACLoadTerminals.App</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
    <PackageReference Include="ScottPlot.WPF" Version="5.1.59" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Core\HVACLoadTerminals.Core.csproj" />
    <ProjectReference Include="..\Infrastructure\HVACLoadTerminals.Infrastructure.csproj" />
  </ItemGroup>

  <!-- U1.3: AnyCPU-процесс на x64 грузит WebView2Loader.dll из корня вывода;
       NuGet кладёт туда win-x86, поэтому перезаписываем win-x64
       (тот же приём, что в HVACLoadTerminals.Revit.csproj). -->
  <ItemGroup>
    <AppWebView2Loader Include="$(TargetDir)runtimes\win-x64\native\WebView2Loader.dll" Condition="Exists('$(TargetDir)runtimes\win-x64\native\WebView2Loader.dll')" />
  </ItemGroup>
  <Target Name="CopyWebView2Loader" AfterTargets="Build">
    <Copy SourceFiles="@(AppWebView2Loader)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- Автодеплой в production (запрос владельца 2026-08-26): после Release-сборки
       весь вывод App копируется в d:\Projects\HVACLoadTerminals\production\HVACLoadTerminals.App\.
       Перед сборкой закрывать HVACLoadTerminals.App.exe, иначе файл занят (MSB3027-аналог на Copy). -->
  <PropertyGroup>
    <ProductionDir>d:\Projects\HVACLoadTerminals\production\HVACLoadTerminals.App\</ProductionDir>
  </PropertyGroup>
  <ItemGroup>
    <ProductionFiles Include="$(TargetDir)**\*.*" />
  </ItemGroup>
  <Target Name="DeployToProduction" AfterTargets="Build" Condition="'$(Configuration)'=='Release'">
    <!-- ItemGroup внутри таргета: glob оценивается ПОСЛЕ сборки, иначе при очищенном bin
         список пуст, а при stale-файлах (например, OxyPlot) Copy падает MSB3030. -->
    <ItemGroup>
      <ProductionFiles Include="$(TargetDir)**\*.*" />
    </ItemGroup>
    <Message Text="DeployToProduction -&gt; $(ProductionDir)" Importance="high" />
    <Copy SourceFiles="@(ProductionFiles)" DestinationFiles="@(ProductionFiles->'$(ProductionDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
