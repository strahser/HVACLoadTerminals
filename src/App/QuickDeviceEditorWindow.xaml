<Window x:Class="HVACLoadTerminals.App.QuickDeviceEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Типоразмер — быстрый каталог"
        Height="520" Width="520"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F9">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2D6CDF"/>
        <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#1B4FA8"/>
        <SolidColorBrush x:Key="PanelBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#D5DBE3"/>
        <SolidColorBrush x:Key="TextDark" Color="#212B36"/>
        <SolidColorBrush x:Key="TextMuted" Color="#637381"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EDF2FC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryDarkBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryDarkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#1F2A44" Padding="12,8">
            <StackPanel>
                <TextBlock Text="Типоразмер прибора" FontSize="13" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="SubtitleText" Text="Быстрое редактирование без ухода с экрана" FontSize="11" Foreground="#AEBBD4" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="8,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Отмена" Click="Cancel_Click"/>
                    <Button Content="💾 Сохранить" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#C0392B" FontSize="11" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="ID:" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="IdBox" Margin="0,4" Padding="4,2" IsReadOnly="True" Background="#F7F9FC" ToolTip="Генерируется автоматически для новых"/>

                <TextBlock Grid.Row="1" Text="Система:" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="SystemCombo" Margin="0,4" IsEnabled="False"/>

                <TextBlock Grid.Row="2" Text="Семейство:" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="FamilyBox" Margin="0,4" Padding="4,2"/>

                <TextBlock Grid.Row="3" Text="Типоразмер:" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="TypeBox" Margin="0,4" Padding="4,2"/>

                <TextBlock Grid.Row="4" Text="Производитель:" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                <TextBox Grid.Row="4" Grid.Column="1" x:Name="ManufacturerBox" Margin="0,4" Padding="4,2"/>

                <TextBlock Grid.Row="5" Text="Расход, м³/ч:" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                <TextBox Grid.Row="5" Grid.Column="1" x:Name="FlowBox" Margin="0,4" Padding="4,2"/>

                <TextBlock Grid.Row="6" Text="S обслуж., м²:" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                <TextBox Grid.Row="6" Grid.Column="1" x:Name="ServiceBox" Margin="0,4" Padding="4,2"/>

                <TextBlock Grid.Row="7" Text="Отступ стены, мм:" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                <TextBox Grid.Row="7" Grid.Column="1" x:Name="WallOffsetBox" Margin="0,4" Padding="4,2" ToolTip="wall_offset прототипа"/>

                <TextBlock Grid.Row="8" Text="Отступ потолка, мм:" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                <TextBox Grid.Row="8" Grid.Column="1" x:Name="CeilingOffsetBox" Margin="0,4" Padding="4,2"/>

                <TextBlock Grid.Row="9" Text="Форма в плане:" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                <ComboBox Grid.Row="9" Grid.Column="1" x:Name="ShapeCombo" Margin="0,4" Padding="4,2"/>

                <TextBlock Grid.Row="10" Text="Габариты Д×Ш, мм:" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                <StackPanel Grid.Row="10" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                    <TextBox x:Name="WidthBox" Width="80" Padding="4,2" ToolTip="Для прямоугольника — ширина × высота, для круга — диаметр (в Width)"/>
                    <TextBlock Text="×" VerticalAlignment="Center" Margin="6,0"/>
                    <TextBox x:Name="HeightBox" Width="80" Padding="4,2"/>
                    <TextBlock Text="Ø" VerticalAlignment="Center" Margin="10,0,4,0" Foreground="{StaticResource TextMuted}"/>
                    <TextBox x:Name="DiameterBox" Width="70" Padding="4,2" ToolTip="Диаметр для круглого — приоритет над Width"/>
                </StackPanel>

                <TextBlock Grid.Row="11" Text="Q хол/отопл, Вт:" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                <StackPanel Grid.Row="11" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                    <TextBox x:Name="CoolBox" Width="80" Padding="4,2" ToolTip="0 = не применимо"/>
                    <TextBlock Text="/" VerticalAlignment="Center" Margin="6,0"/>
                    <TextBox x:Name="HeatBox" Width="80" Padding="4,2"/>
                </StackPanel>

                <TextBlock Grid.Row="12" Text="Параметр расхода:" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                <TextBox Grid.Row="12" Grid.Column="1" x:Name="ParamBox" Margin="0,4" Padding="4,2" Text="ADSK_Расход воздуха"/>

                <TextBlock Grid.Row="13" Text="Директивы:" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                <StackPanel Grid.Row="13" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                    <TextBox x:Name="DirectiveNBox" Width="60" Padding="4,2" ToolTip="directive_terminals"/>
                    <TextBlock Text="шт" VerticalAlignment="Center" Margin="4,0,8,0" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                    <TextBox x:Name="DirectiveLBox" Width="70" Padding="4,2" ToolTip="directive_length мм"/>
                    <TextBlock Text="мм" VerticalAlignment="Center" Margin="4,0" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
