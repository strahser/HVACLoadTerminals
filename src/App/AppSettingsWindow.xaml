<Window x:Class="HVACLoadTerminals.App.AppSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:scott="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        xmlns:models="clr-namespace:HVACLoadTerminals.Core.Models;assembly=HVACLoadTerminals.Core"
        Title="Настройки — HVAC Terminals"
        Height="740" Width="1100"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F9">
    <Window.Resources>
        <x:Array x:Key="PlanShapes" Type="{x:Type models:DevicePlanShape}">
            <x:Static Member="models:DevicePlanShape.Rectangular"/>
            <x:Static Member="models:DevicePlanShape.Circular"/>
        </x:Array>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2D6CDF"/>
        <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#1B4FA8"/>
        <SolidColorBrush x:Key="PanelBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#D5DBE3"/>
        <SolidColorBrush x:Key="TextDark" Color="#212B36"/>
        <SolidColorBrush x:Key="TextMuted" Color="#637381"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EDF2FC"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryDarkBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryDarkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#B9C6DE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AlternatingRowBackground" Value="#F7F9FC"/>
            <Setter Property="RowHeight" Value="26"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EEF1F5"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource PrimaryDarkBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="BorderBrush" Value="#163A78"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#1F2A44" Padding="14,8">
            <StackPanel>
                <TextBlock Text="Настройки" FontSize="15" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Оборудование · методы расчёта и геометрия · нагрузки систем · прочие параметры" FontSize="11" Foreground="#AEBBD4" TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="8,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Сброс к заводским" Click="ResetAll_Click" ToolTip="Сбросить глобальные правила и UI к дефолту"/>
                    <Button Content="Отмена" Click="Cancel_Click"/>
                    <Button Content="Применить" Style="{StaticResource PrimaryButton}" Click="Apply_Click"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <TabControl x:Name="MainTabs" Margin="8" Background="Transparent" BorderThickness="0">
            <!-- ========== TAB 1: Оборудование ========== -->
            <TabItem Header="Оборудование">
                <Border Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="#FAFBFD" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                            <WrapPanel VerticalAlignment="Center">
                                <Button Content="＋ Добавить" Click="EquipmentAdd_Click" ToolTip="Добавить типоразмер выбранного класса"/>
                                <Button Content="✕ Удалить" Click="EquipmentDelete_Click" ToolTip="Удалить выбранные"/>
                                <Rectangle Width="1" Height="22" Fill="{StaticResource BorderBrush}" Margin="6,0"/>
                                <TextBlock Text="Класс:" VerticalAlignment="Center" Margin="4,0,4,0" Foreground="{StaticResource TextMuted}"/>
                                <ComboBox x:Name="EquipmentFilterCombo" Width="150" VerticalContentAlignment="Center" SelectionChanged="EquipmentFilter_Changed"/>
                                <TextBox x:Name="EquipmentSearchBox" Width="180" Margin="8,0,0,0" Padding="5,3" VerticalContentAlignment="Center" ToolTip="Поиск по семейству/типоразмеру" TextChanged="EquipmentSearch_TextChanged"/>
                                <Rectangle Width="1" Height="22" Fill="{StaticResource BorderBrush}" Margin="8,0"/>
                                <Button Content="↻ Демо" Click="EquipmentResetDemo_Click" ToolTip="Заменить встроенным демо-каталогом (14 типоразмеров)"/>
                                <Button Content="💾 Сохранить каталог" Style="{StaticResource PrimaryButton}" Click="EquipmentSave_Click" ToolTip="Атомарно записать catalog.json"/>
                                <TextBlock x:Name="EquipmentFileText" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                            </WrapPanel>
                        </Border>
                        <TextBlock DockPanel.Dock="Bottom" x:Name="EquipmentStatusText" Margin="4,6,4,0" Foreground="#1E7B34" FontSize="11" TextWrapping="Wrap"/>
                        <!-- Группировка по семействам слева + грид -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#F7F9FC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,6,0">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="Семейства" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" Margin="8,6,8,4"/>
                                    <ListBox x:Name="FamilyListBox" Margin="4" BorderThickness="0" Background="Transparent" SelectionChanged="FamilyList_Changed"/>
                                </DockPanel>
                            </Border>
                            <DataGrid Grid.Column="1" x:Name="EquipmentGrid" SelectionMode="Extended" SelectionUnit="FullRow">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Id" Binding="{Binding Id, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                                    <DataGridTextColumn Header="Семейство" Binding="{Binding FamilyName, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                                    <DataGridTextColumn Header="Типоразмер" Binding="{Binding TypeName, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                                    <DataGridTextColumn Header="Система" Binding="{Binding SystemType, UpdateSourceTrigger=PropertyChanged}" Width="75"/>
                                    <DataGridComboBoxColumn Header="Форма" SelectedValueBinding="{Binding PlanShape, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{StaticResource PlanShapes}" Width="95"/>
                                    <DataGridTextColumn Header="Расход, м³/ч" Binding="{Binding MaxFlowRate, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                                    <DataGridTextColumn Header="S обслуж., м²" Binding="{Binding ServiceAreaM2, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                                    <DataGridTextColumn Header="Длина, мм" Binding="{Binding WidthMm, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                    <DataGridTextColumn Header="Высота, мм" Binding="{Binding HeightMm, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                    <DataGridTextColumn Header="Ø, мм" Binding="{Binding DiameterMm, UpdateSourceTrigger=PropertyChanged}" Width="65"/>
                                    <DataGridTextColumn Header="Q хол., Вт" Binding="{Binding CoolingCapacityW, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                    <DataGridTextColumn Header="Q отопл., Вт" Binding="{Binding HeatingCapacityW, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                                    <DataGridTextColumn Header="Отступ ст., мм" Binding="{Binding WallOffsetMm, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                                    <DataGridTextColumn Header="Отступ пот., мм" Binding="{Binding CeilingOffsetMm, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                                    <DataGridTextColumn Header="Производитель" Binding="{Binding Manufacturer, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- ========== TAB 2: Расчёт и геометрия ========== -->
            <TabItem Header="Расчёт и геометрия">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="440"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- Левая панель: настройки -->
                    <Border Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,4,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,6">
                            <StackPanel>
                                <TextBlock Text="Глобальные правила (по умолчанию)" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
                                <TextBlock Text="Применяются, когда у системы нет переопределения" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,2,0,6"/>

                                <TextBlock Style="{StaticResource SectionHeader}" Text="Отопление — доля от окна"/>
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="55"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="RatioSlider" Minimum="0.3" Maximum="1.0" SmallChange="0.05" LargeChange="0.1" TickFrequency="0.1" ValueChanged="RatioSlider_ValueChanged"/>
                                    <TextBox Grid.Column="1" x:Name="RatioBox" Margin="6,0,0,0" Padding="4,2" VerticalContentAlignment="Center" TextChanged="RatioBox_TextChanged"/>
                                </Grid>
                                <TextBlock Text="Мин. суммарная длина приборов ≥ доли ширины окна (60% — практика)" Foreground="{StaticResource TextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0"/>

                                <TextBlock Style="{StaticResource SectionHeader}" Text="Приток"/>
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="85"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Метод:"/>
                                    <ComboBox Grid.Column="1" x:Name="SupplyRuleCombo" SelectionChanged="SupplyRule_Changed"/>
                                </Grid>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="85"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="N фикс:"/>
                                    <TextBox x:Name="FixedBox" Grid.Column="1" Padding="4,2" VerticalContentAlignment="Center" TextChanged="FixedBox_TextChanged"/>
                                    <TextBlock Grid.Column="2" Text="(при Fixed)" Foreground="{StaticResource TextMuted}" FontSize="10" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </Grid>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="85"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Паттерн:"/>
                                    <ComboBox Grid.Column="1" x:Name="SupplyPatternCombo" SelectionChanged="Pattern_Changed"/>
                                </Grid>

                                <TextBlock Style="{StaticResource SectionHeader}" Text="Вытяжка"/>
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="85"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Метод:"/>
                                    <ComboBox Grid.Column="1" x:Name="ExhaustRuleCombo" SelectionChanged="ExhaustRule_Changed"/>
                                </Grid>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="85"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Паттерн:"/>
                                    <ComboBox Grid.Column="1" x:Name="ExhaustPatternCombo" SelectionChanged="Pattern_Changed"/>
                                </Grid>

                                <TextBlock Style="{StaticResource SectionHeader}" Text="Одиночный прибор"/>
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="85"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Размещение:"/>
                                    <ComboBox Grid.Column="1" x:Name="SingleRuleCombo" SelectionChanged="SingleRule_Changed"/>
                                </Grid>

                                <TextBlock Style="{StaticResource SectionHeader}" Text="Решётки"/>
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="85"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="v, м/с:"/>
                                    <Slider Grid.Column="1" x:Name="VelocitySlider" Minimum="0.5" Maximum="5.0" SmallChange="0.1" LargeChange="0.5" ValueChanged="VelocitySlider_ValueChanged"/>
                                    <TextBox Grid.Column="2" x:Name="VelocityBox" Margin="6,0,0,0" Padding="4,2" VerticalContentAlignment="Center" TextChanged="VelocityBox_TextChanged"/>
                                </Grid>
                                <TextBlock Text="Скорость в живом сечении (A = L / 3600·v)" Foreground="{StaticResource TextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0"/>

                                <TextBlock Style="{StaticResource SectionHeader}" Text="Отопление — зазоры"/>
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="От стены, мм:"/>
                                    <TextBox Grid.Column="1" x:Name="HeatingWallBox" Padding="4,2" TextChanged="HeatingBox_TextChanged"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource FieldLabel}" Text="Высота, мм:" Margin="6,0,0,0"/>
                                    <TextBox Grid.Column="3" x:Name="HeatingMountBox" Padding="4,2" TextChanged="HeatingBox_TextChanged"/>
                                </Grid>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Край, мм:"/>
                                    <TextBox Grid.Column="1" x:Name="HeatingEdgeBox" Padding="4,2" TextChanged="HeatingBox_TextChanged"/>
                                </Grid>

                                <CheckBox x:Name="ShortSideTwoCheck" Content="2 прибора на короткой стороне если &gt;1500 мм" Margin="0,8,0,4" ToolTip="Когда короткая сторона &gt;1500 мм и правило «короткая сторона» даёт 1 — принудительно 2" Click="ShortSideTwo_Click"/>

                                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,10,0,6"/>
                                <TextBlock Text="Переопределения по системам" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
                                <TextBlock Text="Индивидуальные настройки — выше глобальных. Пусто = по умолчанию" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,2,0,6"/>
                                <DataGrid x:Name="SystemsGrid" Height="160" SelectionMode="Single" AutoGenerateColumns="False" CanUserAddRows="False" SelectionChanged="SystemsGrid_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Система" Binding="{Binding Name}" Width="70"/>
                                        <DataGridTextColumn Header="Тип" Binding="{Binding TypeText}" Width="80" IsReadOnly="True"/>
                                        <DataGridComboBoxColumn x:Name="SysRuleColumn" Header="Метод" SelectedValueBinding="{Binding CountRuleOverride, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                                        <DataGridTextColumn Header="N" Binding="{Binding FixedCountOverride, UpdateSourceTrigger=PropertyChanged}" Width="45"/>
                                        <DataGridComboBoxColumn x:Name="SysPatternColumn" Header="Паттерн" SelectedValueBinding="{Binding PatternOverride, UpdateSourceTrigger=PropertyChanged}" Width="95"/>
                                        <DataGridComboBoxColumn x:Name="SysSingleColumn" Header="Одиночн." SelectedValueBinding="{Binding SingleRuleOverride, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                                        <DataGridTextColumn Header="Отступ ст., мм" Binding="{Binding EdgeOffsetOverrideMm, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                                        <DataGridTextColumn Header="Потолок, мм" Binding="{Binding CeilingOffsetOverrideMm, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button Content="Сбросить выделенную" Click="ResetSystemOverride_Click" ToolTip="Сбросить переопределения выбранной системы к глобальным"/>
                                    <Button Content="Сбросить все" Click="ResetAllSystems_Click"/>
                                </StackPanel>

                                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,10,0,6"/>
                                <TextBlock Text="Профили" FontWeight="SemiBold" Foreground="{StaticResource TextDark}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button Content="💾 Сохранить" Click="SaveProfile_Click"/>
                                    <Button Content="📂 Загрузить" Click="LoadProfile_Click"/>
                                    <Button Content="🗑 Удалить" Click="DeleteProfile_Click"/>
                                </StackPanel>
                                <ComboBox x:Name="ProfileCombo" Margin="0,6,0,0" ToolTip="Сохранённые профили placement-profiles"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Правая панель: графика -->
                    <Border Grid.Column="1" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Margin="4,0,0,0">
                        <DockPanel Margin="6">
                            <TextBlock DockPanel.Dock="Top" Text="Графические схемы размещения — типовая комната 10×6м, 3 прибора притока" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" Margin="4,4,4,6"/>
                            <Grid DockPanel.Dock="Top" Margin="4,0,4,6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- 4 карточки паттернов -->
                                <Border Grid.Row="0" Grid.Column="0" x:Name="CardGrid" BorderThickness="2" CornerRadius="6" Margin="4" Padding="4" Cursor="Hand" MouseDown="CardGrid_MouseDown" ToolTip="Сетка по потолку — равномерная сетка внутри отступа">
                                    <StackPanel>
                                        <TextBlock Text="Сетка" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center"/>
                                        <Canvas x:Name="CanvasGrid" Width="120" Height="80" Background="White" Margin="0,4,0,2"/>
                                        <TextBlock Text="CeilingGrid" FontSize="9" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="1" x:Name="CardLong" BorderThickness="2" CornerRadius="6" Margin="4" Padding="4" Cursor="Hand" MouseDown="CardLong_MouseDown" ToolTip="Вдоль длинной стороны — ряд приборов вдоль максимальной грани">
                                    <StackPanel>
                                        <TextBlock Text="Длинная" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center"/>
                                        <Canvas x:Name="CanvasLong" Width="120" Height="80" Background="White" Margin="0,4,0,2"/>
                                        <TextBlock Text="LongSide" FontSize="9" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="2" x:Name="CardShort" BorderThickness="2" CornerRadius="6" Margin="4" Padding="4" Cursor="Hand" MouseDown="CardShort_MouseDown" ToolTip="Вдоль короткой стороны — ряд вдоль минимальной грани">
                                    <StackPanel>
                                        <TextBlock Text="Короткая" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center"/>
                                        <Canvas x:Name="CanvasShort" Width="120" Height="80" Background="White" Margin="0,4,0,2"/>
                                        <TextBlock Text="ShortSide" FontSize="9" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="3" x:Name="CardExplicit" BorderThickness="2" CornerRadius="6" Margin="4" Padding="4" Cursor="Hand" MouseDown="CardExplicit_MouseDown" ToolTip="Явная сторона — ручной выбор грани">
                                    <StackPanel>
                                        <TextBlock Text="Явная" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center"/>
                                        <Canvas x:Name="CanvasExplicit" Width="120" Height="80" Background="White" Margin="0,4,0,2"/>
                                        <TextBlock Text="Explicit" FontSize="9" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <!-- Одиночный Center / Corner -->
                                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" x:Name="CardCenter" BorderThickness="2" CornerRadius="6" Margin="4" Padding="4" Cursor="Hand" MouseDown="CardCenter_MouseDown" ToolTip="Один прибор — в центре зоны">
                                    <StackPanel Orientation="Horizontal">
                                        <Canvas x:Name="CanvasCenter" Width="100" Height="60" Background="White" Margin="4"/>
                                        <StackPanel VerticalAlignment="Center" Margin="8,0,0,0">
                                            <TextBlock Text="Одиночный — Центр" FontWeight="SemiBold" FontSize="11"/>
                                            <TextBlock Text=" Center — в середине" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" x:Name="CardCorner" BorderThickness="2" CornerRadius="6" Margin="4" Padding="4" Cursor="Hand" MouseDown="CardCorner_MouseDown" ToolTip="Один прибор — в углу зоны">
                                    <StackPanel Orientation="Horizontal">
                                        <Canvas x:Name="CanvasCorner" Width="100" Height="60" Background="White" Margin="4"/>
                                        <StackPanel VerticalAlignment="Center" Margin="8,0,0,0">
                                            <TextBlock Text="Одиночный — Угол" FontWeight="SemiBold" FontSize="11"/>
                                            <TextBlock Text=" Corner — в углу" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <TextBlock DockPanel.Dock="Top" Text="Превью — ScottPlot (взаимодействие как в «Правила размещения»)" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="4,0,0,4"/>
                            <scott:WpfPlot x:Name="PreviewPlot" Background="White"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ========== TAB 3: Нагрузки ========== -->
            <TabItem Header="Нагрузки">
                <Border Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <WrapPanel x:Name="LoadTotalsPanel" Orientation="Horizontal" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Text="Сводка по системам" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" Margin="0,0,0,4"/>
                                    <DataGrid x:Name="LoadSystemsGrid" Height="200" IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Система" Binding="{Binding SystemName}" Width="90"/>
                                            <DataGridTextColumn Header="Тип" Binding="{Binding TypeText}" Width="90"/>
                                            <DataGridTextColumn Header="Комнат" Binding="{Binding RoomCount}" Width="70"/>
                                            <DataGridTextColumn Header="Σ, м³/ч" Binding="{Binding TotalFlow, StringFormat=F0}" Width="90"/>
                                            <DataGridTextColumn Header="Ср." Binding="{Binding AvgFlow, StringFormat=F0}" Width="70"/>
                                            <DataGridTextColumn Header="Площадь, м²" Binding="{Binding TotalArea, StringFormat=F1}" Width="90"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="Сводка по уровням" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" Margin="0,0,0,4"/>
                                    <DataGrid x:Name="LoadLevelsGrid" Height="200" IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Уровень" Binding="{Binding LevelName}" Width="120"/>
                                            <DataGridTextColumn Header="Комнат" Binding="{Binding RoomCount}" Width="70"/>
                                            <DataGridTextColumn Header="S, м²" Binding="{Binding TotalArea, StringFormat=F1}" Width="70"/>
                                            <DataGridTextColumn Header="Q, кВт" Binding="{Binding TotalHeatingKw, StringFormat=F1}" Width="70"/>
                                            <DataGridTextColumn Header="Приток" Binding="{Binding TotalSupply, StringFormat=F0}" Width="70"/>
                                            <DataGridTextColumn Header="Вытяжка" Binding="{Binding TotalExhaust, StringFormat=F0}" Width="75"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Left">
                                <Button Content="↻ Пересчитать нагрузки" Click="LoadsRecalc_Click"/>
                                <Button Content="📊 Детальная сводка…" Click="LoadsDetail_Click" Style="{StaticResource PrimaryButton}" ToolTip="Открыть окно с таблицей по помещениям"/>
                                <Button Content="⬇ Excel" Click="LoadsExcel_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="LoadsStatusText" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- ========== TAB 4: Прочие ========== -->
            <TabItem Header="Прочие">
                <Border Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Интерфейс" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
                            <WrapPanel Margin="0,6,0,0">
                                <CheckBox x:Name="ChkTreePanel" Content="Дерево систем" Margin="0,4,16,4" Click="OtherCheck_Click"/>
                                <CheckBox x:Name="ChkPropsPanel" Content="Панель свойств" Margin="0,4,16,4" Click="OtherCheck_Click"/>
                                <CheckBox x:Name="ChkEnclosure" Content="Кривые ограждений" Margin="0,4,16,4" Click="OtherCheck_Click" ToolTip="Только у выбранных помещений"/>
                                <CheckBox x:Name="ChkRoomLabels" Content="Подписи комнат" Margin="0,4,16,4" Click="OtherCheck_Click"/>
                                <CheckBox x:Name="ChkCanvasPlan" Content="Canvas-план" Margin="0,4,16,4" Click="OtherCheck_Click"/>
                                <CheckBox x:Name="ChkAllSystems" Content="Все системы на плане" Margin="0,4,16,4" Click="OtherCheck_Click"/>
                                <CheckBox x:Name="ChkBottomPlan" Content="План внизу" Margin="0,4,16,4" Click="OtherCheck_Click"/>
                                <CheckBox x:Name="ChkLiveRecalc" Content="Живой пересчёт" Margin="0,4,16,4" Click="OtherCheck_Click"/>
                                <CheckBox x:Name="ChkAutoLoad" Content="Автозагрузка проекта" Margin="0,4,16,4" Click="OtherCheck_Click"/>
                            </WrapPanel>

                            <TextBlock Text="Размеры панелей и окна" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" Margin="0,12,0,4"/>
                            <WrapPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Дерево, px:"/>
                                <TextBox x:Name="TreeWidthBox" Width="60" Padding="4,2" Margin="0,0,12,0" TextChanged="OtherNumber_TextChanged"/>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Свойства, px:"/>
                                <TextBox x:Name="PropsWidthBox" Width="60" Padding="4,2" Margin="0,0,12,0" TextChanged="OtherNumber_TextChanged"/>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Окно Ш×В:"/>
                                <TextBox x:Name="WinWBox" Width="60" Padding="4,2" TextChanged="OtherNumber_TextChanged"/>
                                <TextBlock Text="×" VerticalAlignment="Center" Margin="4,0"/>
                                <TextBox x:Name="WinHBox" Width="60" Padding="4,2" Margin="4,0,0,0" TextChanged="OtherNumber_TextChanged"/>
                            </WrapPanel>

                            <TextBlock Text="Геометрия размещения" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" Margin="0,12,0,4"/>
                            <WrapPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Отступ зоны, мм (WallClearance):"/>
                                <TextBox x:Name="WallClearanceBox" Width="70" Padding="4,2" Margin="0,0,16,0" TextChanged="OtherNumber_TextChanged"/>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Live debounce, мс:"/>
                                <TextBox x:Name="DebounceBox" Width="60" Padding="4,2" TextChanged="OtherNumber_TextChanged"/>
                            </WrapPanel>

                            <TextBlock Text="Файлы и пути" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" Margin="0,12,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="Каталог:"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="CatalogPathBox" IsReadOnly="True" Background="#F7F9FC" Padding="4,2" Margin="0,2"/>
                                <Button Grid.Row="0" Grid.Column="2" Content="Открыть" Click="OpenCatalogFolder_Click" Margin="4,2,0,2"/>
                                <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="ui-settings:"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="UiPathBox" IsReadOnly="True" Background="#F7F9FC" Padding="4,2" Margin="0,2"/>
                                <Button Grid.Row="1" Grid.Column="2" Content="Открыть" Click="OpenUiFolder_Click" Margin="4,2,0,2"/>
                                <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Профили:"/>
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="ProfilesPathBox" IsReadOnly="True" Background="#F7F9FC" Padding="4,2" Margin="0,2"/>
                                <Button Grid.Row="2" Grid.Column="2" Content="Открыть" Click="OpenProfilesFolder_Click" Margin="4,2,0,2"/>
                            </Grid>

                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,12,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Сбросить UI к дефолту" Click="ResetUi_Click"/>
                                <Button Content="Очистить недавние" Click="ClearRecent_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="OtherStatusText" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
