<Window x:Class="HVACLoadTerminals.App.RoomDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        Title="План помещения"
        Height="720" Width="1100"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F9">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2D6CDF"/>
        <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#1B4FA8"/>
        <SolidColorBrush x:Key="PanelBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#D5DBE3"/>
        <SolidColorBrush x:Key="TextDark" Color="#212B36"/>
        <SolidColorBrush x:Key="TextMuted" Color="#637381"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EDF2FC"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#DCE7FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryDarkBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryDarkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#B9C6DE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StepLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10,0,3,0"/>
        </Style>
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="42"/>
            <Setter Property="Margin" Value="2,0"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Заголовок -->
        <Border DockPanel.Dock="Top" Background="#1F2A44" Padding="14,6">
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="14" FontWeight="Bold" Foreground="White" Text="Помещение"/>
                <TextBlock x:Name="SubtitleText" FontSize="11" Foreground="#AEBBD4" Text="Нумерация стен 1..n — выбор для размещения" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Кнопки -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="8,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Сброс привязки" Padding="8,6" Click="ResetWall_Click" ToolTip="Сбросить привязку к стене (Авто)"/>
                    <Button Content="Отмена" Padding="14,6" Click="Cancel_Click"/>
                    <Button Content="Применить" Style="{StaticResource PrimaryButton}" Padding="14,6" Click="Apply_Click"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- План -->
            <Border Grid.Column="0" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Margin="8">
                <oxy:PlotView x:Name="Plot" Model="{Binding PlotModel}"/>
            </Border>
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent"/>

            <!-- Панель настроек -->
            <Border Grid.Column="2" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,8,8,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,8,10,8">
                        <TextBlock Text="Система помещения" FontWeight="SemiBold" Foreground="{StaticResource TextDark}"/>
                        <ComboBox x:Name="SystemCombo" Margin="0,4,0,4" DisplayMemberPath="Name" SelectionChanged="SystemCombo_SelectionChanged"/>
                        <TextBlock Text="Фильтр превью (все/одна):" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,2,0,2"/>
                        <ComboBox x:Name="FilterCombo" Margin="0,0,0,6" SelectionChanged="FilterCombo_SelectionChanged" ToolTip="Показать одну систему или все вместе"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="➕ Система (мастер)…" Padding="6,3" Click="AddSystem_Click"
                                    ToolTip="Мастер: Тип→Класс→Производитель→Марка→Расчёт для этого помещения"/>
                            <Button Content="📋 Все системы…" Padding="6,3" Click="AllSystems_Click"
                                    ToolTip="Список систем помещения (добавить/удалить/расход)"/>
                            <Button Content="▶ Рассчитать" Padding="6,3" Click="RecalcRoom_Click"
                                    ToolTip="Пересчитать расстановку и обновить превью"/>
                        </StackPanel>

                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,4,0,8"/>

                        <TextBlock Text="Привязка к стене" FontWeight="SemiBold" Foreground="{StaticResource TextDark}"/>
                        <TextBlock Text="Стены пронумерованы 1..n по обходу контура. Выберите стену для размещения диффузоров вдоль неё." 
                                   Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,6"/>

                        <TextBlock Style="{StaticResource StepLabel}" Margin="0,0,0,2">Стена:</TextBlock>
                        <ComboBox x:Name="WallCombo" Margin="0,0,0,6" SelectionChanged="WallCombo_SelectionChanged"/>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Смещение, мм:" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                            <TextBox x:Name="OffsetBox" Grid.Column="1" Margin="6,0,6,0" Padding="5,3" VerticalContentAlignment="Center" TextChanged="OffsetBox_TextChanged"/>
                            <TextBlock Grid.Column="2" Text="от стены внутрь" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                        </Grid>

                        <TextBlock Style="{StaticResource StepLabel}" Margin="0,0,0,2">Правило одного прибора:</TextBlock>
                        <ComboBox x:Name="SingleRuleCombo" Margin="0,0,0,8" SelectionChanged="SingleRuleCombo_SelectionChanged"/>

                        <TextBlock x:Name="WallInfoText" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,8" LineHeight="15"/>

                        <TextBlock Text="Сводка по системам" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" Margin="0,4,0,4"/>
                        <DataGrid x:Name="SummaryGrid" Height="110" Margin="0,0,0,8" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" FontSize="11" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Система" Binding="{Binding SystemName}" Width="70"/>
                                <DataGridTextColumn Header="Σ расход" Binding="{Binding FlowText}" Width="70"/>
                                <DataGridTextColumn Header="N" Binding="{Binding CountText}" Width="40"/>
                                <DataGridTextColumn Header="Марка" Binding="{Binding DeviceText}" Width="*"/>
                                <DataGridTextColumn Header="k_ef" Binding="{Binding KefText}" Width="50"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,4,0,8"/>

                        <TextBlock Text="Подсказка" FontWeight="SemiBold" Foreground="{StaticResource TextDark}"/>
                        <TextBlock Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" LineHeight="15" Margin="0,2,0,0">
                            <Run Text="• Выберите стену 1 и смещение 500 → диффузоры встанут линией на 500мм от стены 1."/><LineBreak/>
                            <Run Text="• «Авто» — используется общий паттерн (длинная/короткая сторона, сетка)."/><LineBreak/>
                            <Run Text="• Центр — одиночный прибор в середине выбранной стены (или в центре помещения при Авто)."/><LineBreak/>
                            <Run Text="• Сетка и офсет-зона (пунктир) перестраиваются живо."/>
                        </TextBlock>

                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,10,0,8"/>
                        <TextBlock x:Name="PreviewInfoText" Foreground="{StaticResource PrimaryDarkBrush}" FontSize="11" TextWrapping="Wrap" FontWeight="SemiBold"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
