<Window x:Class="HVACLoadTerminals.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:HVACLoadTerminals.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="HVAC Terminals · Расстановка приборов по снимку помещений"
        Height="900" Width="1500"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9"
        Loaded="Window_Loaded">

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="O" Command="{Binding OpenSnapshotCommand}"/>
        <KeyBinding Modifiers="Control" Key="S" Command="{Binding SaveProjectCommand}"/>
        <KeyBinding Modifiers="Control" Key="Z" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="F5" Command="{Binding CalculateCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <SolidColorBrush x:Key="PrimaryBrush" Color="#2D6CDF"/>
        <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#1B4FA8"/>
        <SolidColorBrush x:Key="PanelBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#D5DBE3"/>
        <SolidColorBrush x:Key="TextDark" Color="#212B36"/>
        <SolidColorBrush x:Key="TextMuted" Color="#637381"/>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EDF2FC"/>
                                <Setter TargetName="bd" Property="BorderBrush"
                                        Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#DCE7FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryDarkBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{StaticResource PrimaryDarkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#B9C6DE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StepLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10,0,3,0"/>
        </Style>

        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="42"/>
            <Setter Property="Margin" Value="2,0"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AlternatingRowBackground" Value="#F7F9FC"/>
            <Setter Property="RowHeight" Value="26"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EEF1F5"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource PrimaryDarkBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="BorderBrush" Value="#163A78"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ============ МЕНЮ (этап C: все мета-операции здесь) ============ -->
        <Menu DockPanel.Dock="Top" Background="#FFFFFF" Padding="4,2"
              BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <MenuItem Header="_Файл">
                <MenuItem Header="Открыть снимок…  (Ctrl+O)" Command="{Binding OpenSnapshotCommand}"/>
                <MenuItem Header="Загрузить проект…" Command="{Binding LoadProjectCommand}"/>
                <MenuItem Header="Сохранить проект…  (Ctrl+S)" Command="{Binding SaveProjectCommand}"/>
                <Separator/>
                <MenuItem Header="Выход" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Правка">
                <MenuItem Header="↶ Отменить  (Ctrl+Z)" Command="{Binding UndoCommand}" ToolTip="{Binding UndoStatus}"/>
                <Separator/>
                <MenuItem Header="Рассчитать  (F5)" FontWeight="SemiBold"
                          Command="{Binding CalculateCommand}"/>
                <Separator/>
                <MenuItem Header="➕ Назначить систему выбранным…" Command="{Binding AssignSystemCommand}"
                          ToolTip="Тип, название, прибор и опции установки — для выделенных помещений"/>
                <MenuItem Header="⚙ К выбранным (оверрайды)…" Command="{Binding ApplyMassCommand}"/>
                <MenuItem Header="Применить назначение к уровню" Command="{Binding ApplyPurposeCommand}"
                          CommandParameter="Office"/>
                <Separator/>
                <MenuItem Header="☑ Включить помещения уровня" Command="{Binding IncludeLevelCommand}"/>
                <MenuItem Header="☑ Включить видимые" Command="{Binding IncludeVisibleCommand}"/>
                <MenuItem Header="☐ Исключить видимые" Command="{Binding ExcludeVisibleCommand}"/>
                <Separator/>
                <MenuItem Header="Выделить все строки" Click="SelectAllRows_Click"/>
                <MenuItem Header="Снять выделение строк" Click="UnselectAllRows_Click"/>
            </MenuItem>
            <MenuItem Header="_Вид">
                <MenuItem Header="Дерево систем" IsCheckable="True"
                          IsChecked="{Binding ShowTreePanel}"/>
                <MenuItem Header="Панель свойств" IsCheckable="True"
                          IsChecked="{Binding ShowPropsPanel}"/>
                <Separator/>
                <MenuItem Header="Кривые ограждений (выбранные)" IsCheckable="True"
                          IsChecked="{Binding ShowEnclosureCurves}"
                          ToolTip="Стены/окна рисуются только у помещений, выделенных в списке"/>
                <MenuItem Header="Подписи комнат на плане" IsCheckable="True"
                          IsChecked="{Binding ShowRoomLabels}"/>
            </MenuItem>
            <MenuItem Header="_Экспорт">
                <MenuItem Header="📄 Отчёт уровня (HTML)" Command="{Binding ExportReportCommand}"/>
                <MenuItem Header="🌐 HTML-сцена" Command="{Binding ExportHtmlCommand}"/>
                <MenuItem Header="⬇ Задание JSON" Command="{Binding ExportTaskCommand}"/>
                <MenuItem Header="⬇ Excel (level_values + Приборы)" Command="{Binding ExportExcelCommand}"/>
            </MenuItem>
            <MenuItem Header="_Сервис">
                <MenuItem Header="🗂 Каталог приборов…" Command="{Binding EditCatalogCommand}"/>
                <MenuItem Header="⚙ Правила размещения…" Click="PlacementRules_Click" ToolTip="Глобальные правила: доля от окна, паттерны, скорость решёток — слайдеры + превью + профили"/>
                <MenuItem Header="↻ Вернуть авторасчёт нагрузок" Command="{Binding RecalcLoadsCommand}"/>
                <MenuItem Header="Живой пересчёт" IsCheckable="True"
                          IsChecked="{Binding LiveRecalc}"
                          ToolTip="Пересчитывать автоматически при правке полей (по умолчанию выключен — расчёт по F5/кнопке)"/>
                <Separator/>
                <MenuItem Header="Справка" Click="Help_Click"/>
            </MenuItem>
        </Menu>

        <!-- ============ ЗАГОЛОВОК ============ -->
        <Border DockPanel.Dock="Top" Background="#1F2A44" Padding="14,5">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="HVAC Terminals" FontSize="15" FontWeight="Bold"
                           Foreground="White"/>
                <TextBlock Text="  ·  расстановка приборов по снимку помещений"
                           FontSize="12" Foreground="#AEBBD4"
                           VerticalAlignment="Bottom" Margin="4,0,0,1"/>
            </StackPanel>
        </Border>

        <!-- ============ СТАТУСНАЯ СТРОКА ============ -->
        <StatusBar DockPanel.Dock="Bottom" Background="#EAEFF6">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextDark}"/>
        </StatusBar>

        <!-- ============ РАБОЧАЯ ОБЛАСТЬ (этап C: минимализм) ============ -->
        <Grid Margin="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TreeColumn" Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition x:Name="PropsColumn" Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Дерево систем (скрыто по умолчанию — Вид▸Дерево систем) -->
            <Border x:Name="TreePanelBorder" Grid.Column="0" Background="{StaticResource PanelBg}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="6" Margin="0,0,4,0"
                    Visibility="{Binding ShowTreePanel, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="10,8" FontWeight="SemiBold"
                               Foreground="{StaticResource TextDark}">Системы проекта</TextBlock>
                    <TreeView ItemsSource="{Binding TreeRoots}"
                              SelectedItemChanged="CrmTree_SelectedItemChanged"
                              Margin="4,0,4,6" BorderThickness="0">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Title}"/>
                                    <TextBlock Text="{Binding CountText, Mode=OneWay}"
                                               Foreground="{StaticResource TextMuted}"
                                               FontSize="11" Margin="6,0,0,0"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="Padding" Value="2,1"/>
                                <Setter Property="IsExpanded" Value="True"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Left"
                          VerticalAlignment="Stretch" Background="Transparent"
                          Visibility="{Binding ShowTreePanel, Converter={StaticResource BoolToVis}}"/>

            <!-- Центр: сверху список помещений (+приборы табом), снизу план -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1.35*"/>
                </Grid.RowDefinitions>

                <!-- Верх: табы Помещения | Приборы -->
                <TabControl Grid.Row="0" BorderThickness="0" Background="Transparent">
                    <TabItem Header="Помещения">
                        <Border Background="{StaticResource PanelBg}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Контекстная строка таблицы помещений -->
                                <DockPanel Grid.Row="0" Margin="10,8,10,4">
                                    <Button DockPanel.Dock="Right" Content="Системы…"
                                            Padding="6,2" Click="EditSystems_Click_Grid"
                                            ToolTip="Показать системы первой выделенной комнаты"/>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                VerticalAlignment="Center" Margin="0,0,8,0">
                                        <!-- UX-серия: поиск/фильтр по помещениям -->
                                        <TextBox x:Name="RoomSearchBox" Width="170" Padding="5,3"
                                                 VerticalContentAlignment="Center"
                                                 Text="{Binding RoomSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Поиск по номеру и названию; несколько подстрок через пробел"/>
                                        <ComboBox ItemsSource="{Binding RoomFilterModes}"
                                                  SelectedItem="{Binding RoomFilterMode}"
                                                  Width="175" Margin="6,0,0,0"
                                                  ToolTip="Фильтр по назначенным системам"/>
                                    </StackPanel>
                                    <TextBlock VerticalAlignment="Center"
                                               FontWeight="SemiBold" Foreground="{StaticResource TextDark}">
                                        Помещения — Q, приток, вытяжка, назначение
                                    </TextBlock>
                                </DockPanel>

                                <!-- Назначение/включение: контекст уровня -->
                                <WrapPanel Grid.Row="1" Margin="10,0,10,6">
                                    <TextBlock Style="{StaticResource StepLabel}" Margin="0,0,3,0">Назначение:</TextBlock>
                                    <TextBox x:Name="PurposeBox" Style="{StaticResource InputBox}" Width="90"
                                             Text="Office"/>
                                    <Button Command="{Binding ApplyPurposeCommand}"
                                            CommandParameter="{Binding Text, ElementName=PurposeBox}"
                                            Content="Применить"/>
                                    <Button Command="{Binding IncludeLevelCommand}"
                                            ToolTip="Отметить «Включено» у всех помещений выбранного уровня"
                                            Content="☑ Уровень"/>
                                    <Button Command="{Binding IncludeVisibleCommand}"
                                            ToolTip="Включить помещения, видимые в таблице"
                                            Content="☑ Видимые"/>
                                    <Button Command="{Binding ExcludeVisibleCommand}"
                                            ToolTip="Исключить помещения, видимые в таблице"
                                            Content="☐ Видимые"/>
                                </WrapPanel>

                                <!-- UX-серия: строка контекста — уровень, счётчики, выделение -->
                                <DockPanel Grid.Row="2" Margin="10,0,10,4" LastChildFill="True">
                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                        <Button Content="✓ все" Padding="8,1"
                                                Click="SelectAllRows_Click"
                                                ToolTip="Выделить все видимые строки (Ctrl+A в таблице)"/>
                                        <Button Content="☐ снять" Padding="8,1"
                                                Click="UnselectAllRows_Click"
                                                ToolTip="Снять выделение строк"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding RoomsContextText}"
                                               Foreground="{StaticResource TextMuted}"
                                               FontSize="11" VerticalAlignment="Center"
                                               Margin="10,0,0,0"/>
                                </DockPanel>

                                <DataGrid Grid.Row="3" ItemsSource="{Binding RoomsView}"
                                          Margin="6,0,6,6" BorderThickness="1"
                                          SelectionMode="Extended" SelectionUnit="FullRow"
                                          x:Name="RoomsGrid"
                                          SelectionChanged="RoomsGrid_SelectionChanged"
                                          PreviewMouseRightButtonDown="RoomsGrid_PreviewMouseRightButtonDown"
                                          MouseDoubleClick="RoomsGrid_MouseDoubleClick">
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="🔍 План помещения (стены 1..n)…" Click="OpenRoomDetail_Click" FontWeight="SemiBold"/>
                                            <MenuItem Header="⚙ Системы помещения…" Click="EditSystems_Click_Context"/>
                                            <MenuItem Header="➕ Назначить систему выделенным…" Click="AssignSystemFromContext_Click"/>
                                            <Separator/>
                                            <MenuItem Header="☑ Включить" Click="ContextInclude_Click"/>
                                            <MenuItem Header="☐ Исключить" Click="ContextExclude_Click"/>
                                            <MenuItem Header="📌 Показать кривые на плане" Click="ContextShowOnPlan_Click"/>
                                            <MenuItem Header="↻ Сбросить привязку к стене" Click="ContextResetWall_Click" ToolTip="Сбросить WallIndex/WallOffset для систем выделенных помещений"/>
                                            <Separator/>
                                            <MenuItem Header="📋 Копировать">
                                                <MenuItem Header="Копировать номер" Click="ContextCopyNumber_Click"/>
                                                <MenuItem Header="Копировать имя" Click="ContextCopyName_Click"/>
                                                <MenuItem Header="Копировать S_ID" Click="ContextCopyId_Click"/>
                                                <MenuItem Header="Копировать сводку систем" Click="ContextCopySystems_Click"/>
                                            </MenuItem>
                                            <MenuItem Header="📋 Копировать параметры" Click="ContextCopySystemParams_Click" ToolTip="Копирует WallIndex/WallOffset первой системы для вставки"/>
                                            <Separator/>
                                            <MenuItem Header="Выделить все видимые" Click="SelectAllRows_Click"/>
                                            <MenuItem Header="Снять выделение" Click="UnselectAllRows_Click"/>
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Header="☑"
                                            Binding="{Binding IsIncluded, UpdateSourceTrigger=PropertyChanged}"
                                            Width="34"/>
                                        <DataGridTextColumn Header="№" Binding="{Binding Number}" Width="45"/>
                                        <DataGridTextColumn Header="Помещение" Binding="{Binding Name}" Width="140"/>
                                        <DataGridTextColumn Header="Уровень" Binding="{Binding LevelName}" Width="85"/>
                                        <DataGridTextColumn Header="S, м²" Binding="{Binding Area, StringFormat=F1}" Width="60"/>
                                        <DataGridCheckBoxColumn Header="Угл." Binding="{Binding IsCorner}" Width="45"/>
                                        <DataGridTextColumn Header="Назначение" Binding="{Binding Purpose}" Width="95"/>
                                        <DataGridTextColumn Header="Q, Вт" Binding="{Binding HeatingW}" Width="85"/>
                                        <DataGridTextColumn Header="Приток, м³/ч" Binding="{Binding Supply}" Width="85"/>
                                        <DataGridTextColumn Header="Вытяжка, м³/ч" Binding="{Binding Exhaust}" Width="90"/>
                                        <DataGridTextColumn Header="Системы" Binding="{Binding SystemsSummary, Mode=OneWay}" IsReadOnly="True" Width="95"/>
                                        <DataGridTemplateColumn Width="82">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Системы…" Padding="4,1"
                                                            Click="EditSystems_Click"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Примечание" Binding="{Binding Warning}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- Пустое состояние -->
                                <Border Grid.RowSpan="4" Background="#FBFCFE">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasRooms}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="Нет данных" FontSize="22" FontWeight="Bold"
                                                   Foreground="{StaticResource TextMuted}"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock TextAlignment="Center" Margin="0,10,0,0"
                                                   Foreground="{StaticResource TextMuted}" LineHeight="20">
                                            Меню «Файл» → «Открыть снимок…» (Ctrl+O) — JSON из<LineBreak/>
                                            <Run FontStyle="Italic">HeatLossRevit2 snapshots_raw</Run><LineBreak/>
                                            <LineBreak/>
                                            Помещения и нагрузки появятся автоматически.<LineBreak/>
                                            Затем F5 — расчёт расстановки.
                                        </TextBlock>
                                        <!-- Быстрый старт: демо-фикстура HvackFinal -->
                                        <Button Command="{Binding OpenDemoSnapshotCommand}"
                                                Style="{StaticResource PrimaryButton}"
                                                Padding="16,7" Margin="0,16,0,0"
                                                HorizontalAlignment="Center"
                                                ToolTip="Загрузить тестовый снимок HvackFinal (40 помещений)">
                                            ▶ Загрузить демо-снимок HvackFinal
                                        </Button>
                                        <TextBlock x:Name="DemoPathText" FontSize="11" Margin="0,8,0,0"
                                                   Foreground="{StaticResource TextMuted}"
                                                   TextAlignment="Center" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </TabItem>

                    <!-- Приборы, фильтруются деревом CRM -->
                    <TabItem Header="Приборы">
                        <Border Background="{StaticResource PanelBg}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="6">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Margin="4,4,4,6" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextDark}">
                                    Размещённые приборы (k_ef: &lt;0.6 недогруз · 0.6–0.9 норма · &gt;0.9 перегруз)
                                </TextBlock>
                                <DataGrid x:Name="PlacementsGrid" ItemsSource="{Binding PlacementsView}" BorderThickness="1">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Помещение" Binding="{Binding RoomName}" Width="120"/>
                                        <DataGridTextColumn Header="Уровень" Binding="{Binding LevelName}" Width="85"/>
                                        <DataGridTextColumn Header="Прибор" Binding="{Binding Family}" Width="90"/>
                                        <DataGridTextColumn Header="Типоразмер" Binding="{Binding TypeName}" Width="130"/>
                                        <DataGridTextColumn Header="Система" Binding="{Binding SystemName}" Width="80"/>
                                        <DataGridTextColumn Header="Расход, м³/ч" Binding="{Binding CalculatedFlow, StringFormat=F1}" Width="90"/>
                                        <DataGridTextColumn Header="Высота, мм" Binding="{Binding MountHeightMm}" Width="70"/>
                                        <DataGridTextColumn Header="X, мм" Binding="{Binding X}" Width="80"/>
                                        <DataGridTextColumn Header="Y, мм" Binding="{Binding Y}" Width="80"/>
                                        <DataGridTextColumn Header="Поворот°" Binding="{Binding RotationDeg}" Width="65"/>
                                        <DataGridTextColumn Header="k_ef" Binding="{Binding KEfText}" Width="55">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding KefStatus}" Value="low">
                                                            <Setter Property="Foreground" Value="#E67E22"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding KefStatus}" Value="ok">
                                                            <Setter Property="Foreground" Value="#1E8E3E"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding KefStatus}" Value="high">
                                                            <Setter Property="Foreground" Value="#D93025"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Расчёт" Binding="{Binding CalculationOption}" Width="110"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </TabItem>
                </TabControl>

                <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch"
                              VerticalAlignment="Center" Background="Transparent"/>

                <!-- Низ: ПЛАН уровня -->
                <Border Grid.Row="2" Background="{StaticResource PanelBg}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="6">
                    <DockPanel Margin="4">
                        <DockPanel DockPanel.Dock="Top" Margin="2,2,2,6">
                            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                                    Padding="16,5" Command="{Binding CalculateCommand}"
                                    ToolTip="Разместить отопление под окнами, приток/вытяжку/фанкойлы по системам (F5)">
                                ▶ РАССЧИТАТЬ
                            </Button>
                            <TextBlock Text="Уровень:" VerticalAlignment="Center" Margin="0,0,4,0"
                                       Foreground="{StaticResource TextMuted}"/>
                            <ComboBox ItemsSource="{Binding Levels}"
                                      SelectedItem="{Binding SelectedLevel}"
                                      Width="170" Margin="0,0,12,0"
                                      HorizontalAlignment="Left"/>
                            <TextBlock Text="Цвета:" VerticalAlignment="Center" Margin="0,0,4,0"
                                       Foreground="{StaticResource TextMuted}"/>
                            <ComboBox ItemsSource="{Binding PlanColorModes}"
                                      SelectedItem="{Binding SelectedColorMode}"
                                      Width="120" VerticalContentAlignment="Center"
                                      HorizontalAlignment="Left"/>
                            <CheckBox Content="Подписи" IsChecked="{Binding ShowRoomLabels}"
                                      VerticalAlignment="Center" Margin="12,0,0,0"
                                      HorizontalAlignment="Left"/>
                            <CheckBox Content="Кривые ограждений" IsChecked="{Binding ShowEnclosureCurves}"
                                      VerticalAlignment="Center" Margin="12,0,0,0"
                                      ToolTip="Стены и окна выбранных помещений на плане"/>
                        </DockPanel>

                        <!-- Экспертные параметры расстановки (свёрнуты) -->
                        <Expander DockPanel.Dock="Top" Header="⚙ Параметры расстановки"
                                  IsExpanded="False" Margin="2,0,2,4"
                                  Foreground="{StaticResource TextMuted}">
                            <WrapPanel VerticalAlignment="Center" Margin="6,2,0,4">
                                <TextBlock Style="{StaticResource StepLabel}" Margin="0,0,3,0">Доля от окна:</TextBlock>
                                <TextBox Text="{Binding MinLengthRatio, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputBox}" Width="44"/>
                                <TextBlock Style="{StaticResource StepLabel}">Приток:</TextBlock>
                                <ComboBox ItemsSource="{Binding CountRules}" SelectedItem="{Binding SupplyRule}"
                                          Width="105" Margin="2,0"/>
                                <ComboBox ItemsSource="{Binding WallPatterns}" SelectedItem="{Binding SupplyPattern}"
                                          Width="92" Margin="2,0"/>
                                <TextBlock Style="{StaticResource StepLabel}" Text="N="/>
                                <TextBox Text="{Binding FixedSupplyCount, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputBox}" Width="36"/>
                                <TextBlock Style="{StaticResource StepLabel}">Вытяжка:</TextBlock>
                                <ComboBox ItemsSource="{Binding CountRules}" SelectedItem="{Binding ExhaustRule}"
                                          Width="105" Margin="2,0"/>
                                <ComboBox ItemsSource="{Binding WallPatterns}" SelectedItem="{Binding ExhaustPattern}"
                                          Width="92" Margin="2,0"/>
                                <TextBlock Style="{StaticResource StepLabel}">1 прибор:</TextBlock>
                                <ComboBox ItemsSource="{Binding SingleRules}" SelectedItem="{Binding SingleDeviceRule}"
                                          Width="80" Margin="2,0"/>
                                <TextBlock Style="{StaticResource StepLabel}">v решётки:</TextBlock>
                                <TextBox Text="{Binding GrilleVelocityMs, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputBox}" Width="40"/>
                            </WrapPanel>
                        </Expander>

                        <oxy:PlotView Model="{Binding PlotModel}"/>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Свойства (скрыто по умолчанию — Вид▸Панель свойств) -->
            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Right"
                          VerticalAlignment="Stretch" Background="Transparent"
                          Visibility="{Binding ShowPropsPanel, Converter={StaticResource BoolToVis}}"/>
            <Border x:Name="PropsPanelBorder" Grid.Column="4" Background="{StaticResource PanelBg}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="6" Margin="4,0,0,0"
                    Visibility="{Binding ShowPropsPanel, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="10,8" FontWeight="SemiBold"
                               Foreground="{StaticResource TextDark}">Свойства</TextBlock>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10,4,10,8">
                            <TextBlock Text="{Binding Crm.SelectedNode.Title, TargetNullValue=Выберите узел дерева (Вид▸Дерево систем)}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextDark}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SelectedSystem.TypeText}"
                                       Margin="0,2,0,8" FontSize="11"
                                       Foreground="{StaticResource TextMuted}"/>
                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,4"/>

                            <ContentControl Focusable="False">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl"/>
                                </ContentControl.Style>
                            </ContentControl>

                            <!-- M2.1: редактор свойств системы -->
                            <StackPanel Visibility="{Binding Crm.SelectedSystem.ShowEditing,
                                                    Converter={StaticResource BoolToVis}}">
                                <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}">Имя системы</TextBlock>
                                <DockPanel Margin="0,1,0,10">
                                    <Button DockPanel.Dock="Right" Content="✓"
                                            Command="{Binding Crm.SelectedSystem.ApplyNameCommand}"
                                            ToolTip="Переименовать систему во всех помещениях"
                                            Padding="8,3" Margin="4,0,0,0"/>
                                    <TextBox Text="{Binding Crm.SelectedSystem.NameEditor, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="5,3" VerticalContentAlignment="Center"/>
                                </DockPanel>

                                <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}">Типоразмер прибора</TextBlock>
                                <ComboBox ItemsSource="{Binding Crm.SelectedSystem.Devices}"
                                          SelectedItem="{Binding Crm.SelectedSystem.SelectedDevice}"
                                          DisplayMemberPath="Label" Margin="0,1,0,2"/>
                                <TextBlock Text="{Binding Crm.SelectedSystem.DeviceInfoText}"
                                           FontSize="11" LineHeight="15" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextMuted}" Margin="0,0,0,10"/>

                                <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}">Правило количества</TextBlock>
                                <Grid Margin="0,1,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding Crm.SelectedSystem.Rules}"
                                              SelectedItem="{Binding Crm.SelectedSystem.Rule}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding Crm.SelectedSystem.IsFixedVisible,
                                                             Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="N=" VerticalAlignment="Center" Margin="8,0,2,0"
                                                   Foreground="{StaticResource TextMuted}"/>
                                        <TextBox Width="42" Padding="4,2"
                                                 Text="{Binding Crm.SelectedSystem.FixedCount, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding Crm.SelectedSystem.FormulaText}"
                                           FontSize="11" LineHeight="15" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextDark}" Margin="0,0,0,10"/>

                                <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}">Паттерн расстановки</TextBlock>
                                <ComboBox ItemsSource="{Binding Crm.SelectedSystem.Patterns}"
                                          SelectedItem="{Binding Crm.SelectedSystem.Pattern}" Margin="0,1,0,6"/>
                                <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}">Одиночный прибор</TextBlock>
                                <ComboBox ItemsSource="{Binding Crm.SelectedSystem.SingleRules}"
                                          SelectedItem="{Binding Crm.SelectedSystem.SinglePlacementRule}" Margin="0,1,0,8"/>

                                <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}">Отступы размещения, мм</TextBlock>
                                <Grid Margin="0,1,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="От стен:" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextMuted}" Margin="0,0,4,0"/>
                                    <TextBox Grid.Column="1" Padding="4,2"
                                             Text="{Binding Crm.SelectedSystem.EdgeOffsetMm, TargetNullValue=''}"/>
                                    <TextBlock Grid.Column="2" Text="От потолка:" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextMuted}" Margin="8,0,4,0"/>
                                    <TextBox Grid.Column="3" Padding="4,2"
                                             Text="{Binding Crm.SelectedSystem.CeilingOffsetMm, TargetNullValue=''}"/>
                                </Grid>
                                <oxy:PlotView Model="{Binding Crm.SelectedSystem.SchemeModel}"
                                              Height="130" Margin="0,0,0,8"/>
                            </StackPanel>

                            <!-- Итог по системе -->
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Помещений" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Crm.SelectedSystem.RoomCount}" FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="1" Text="Приборов" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Crm.SelectedSystem.DeviceCount}" FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="2" Text="Σ расход" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Crm.SelectedSystem.FlowText}" FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="3" Text="k_ef средний" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Crm.SelectedSystem.KefText}" FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="4" Text="Типоразмер" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Crm.SelectedSystem.ActualDeviceText}"
                                           FontWeight="SemiBold" MaxWidth="190" TextTrimming="CharacterEllipsis"/>
                            </Grid>

                            <!-- M2.3: свойства помещения -->
                            <StackPanel Visibility="{Binding Crm.HasSelectedRoom,
                                                    Converter={StaticResource BoolToVis}}"
                                        DataContext="{Binding Crm.SelectedRoom}">
                                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Room.SystemsSummary}"
                                               Foreground="{StaticResource TextMuted}" FontSize="11"
                                               VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="Системы…" Padding="6,2"
                                            Click="EditSystemsPanel_Click"/>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Q, Вт:" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextMuted}"/>
                                    <TextBox Grid.Column="1" Padding="4,2"
                                             Text="{Binding Room.HeatingW, UpdateSourceTrigger=LostFocus}"/>
                                    <TextBlock Grid.Column="2" Text="t°:" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextMuted}" Margin="8,0,4,0"/>
                                    <TextBox Grid.Column="3" IsReadOnly="True"
                                             Text="{Binding TemperatureText, Mode=OneWay}" Background="#F7F9FC"/>
                                    <TextBlock Grid.Row="1" Text="Приток:" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextMuted}"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Padding="4,2"
                                             Text="{Binding Room.Supply, UpdateSourceTrigger=LostFocus}"/>
                                    <TextBlock Grid.Row="2" Text="Вытяжка:" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextMuted}"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Padding="4,2"
                                             Text="{Binding Room.Exhaust, UpdateSourceTrigger=LostFocus}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Назначение:"
                                               VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"
                                               Margin="8,0,4,0"/>
                                    <TextBox Grid.Row="1" Grid.Column="3" Padding="4,2"
                                             Text="{Binding Room.Purpose, UpdateSourceTrigger=LostFocus}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Площадь:"
                                               VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"
                                               Margin="8,0,4,0"/>
                                    <TextBox Grid.Row="2" Grid.Column="3" IsReadOnly="True" Background="#F7F9FC"
                                             Text="{Binding Room.Area, Mode=OneWay, StringFormat=F1}"/>
                                </Grid>
                                <TextBlock Margin="0,10,0,0" FontSize="11"
                                           Foreground="{StaticResource TextMuted}"
                                           Text="Проёмы (из снимка)"/>
                                <TextBlock Text="{Binding OpeningsText}" FontSize="11"
                                           LineHeight="15" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextDark}"/>
                                <TextBlock Text="{Binding WindowForecastText}" FontSize="11"
                                           LineHeight="15" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Foreground="{StaticResource PrimaryDarkBrush}"/>
                                <TextBlock Margin="0,10,0,0" FontSize="11"
                                           Foreground="{StaticResource TextMuted}"
                                           Text="Примечание расчёта"/>
                                <TextBlock Text="{Binding Room.Warning}" FontSize="11"
                                           LineHeight="15" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextDark}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
