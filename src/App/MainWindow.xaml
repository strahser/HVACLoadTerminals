<Window x:Class="HVACLoadTerminals.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:HVACLoadTerminals.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="HVAC Terminals · Расстановка приборов по снимку помещений"
        Height="900" Width="1500"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <SolidColorBrush x:Key="PrimaryBrush" Color="#2D6CDF"/>
        <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#1B4FA8"/>
        <SolidColorBrush x:Key="PanelBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#D5DBE3"/>
        <SolidColorBrush x:Key="TextDark" Color="#212B36"/>
        <SolidColorBrush x:Key="TextMuted" Color="#637381"/>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EDF2FC"/>
                                <Setter TargetName="bd" Property="BorderBrush"
                                        Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#DCE7FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryDarkBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{StaticResource PrimaryDarkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#B9C6DE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StepLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10,0,3,0"/>
        </Style>

        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="42"/>
            <Setter Property="Margin" Value="2,0"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AlternatingRowBackground" Value="#F7F9FC"/>
            <Setter Property="RowHeight" Value="26"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EEF1F5"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource PrimaryDarkBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="BorderBrush" Value="#163A78"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ============ СТАТУСНАЯ СТРОКА ============ -->
        <StatusBar DockPanel.Dock="Bottom" Background="#EAEFF6">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextDark}"/>
        </StatusBar>

        <!-- ============ ЗАГОЛОВОК ============ -->
        <Border DockPanel.Dock="Top" Background="#1F2A44" Padding="14,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="HVAC Terminals" FontSize="18" FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock Text="  ·  расстановка приборов по снимку помещений"
                               FontSize="13" Foreground="#AEBBD4"
                               VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                </StackPanel>
                <Expander DockPanel.Dock="Right" Header="Как пользоваться?"
                          Foreground="White" ExpandDirection="Down" Width="360"
                          HorizontalAlignment="Right" Background="#26334F" Padding="6">
                    <TextBlock Foreground="#D9E1F2" FontSize="12" LineHeight="18" TextWrapping="Wrap">
                        <Run>1. «Открыть снимок…» — выбрать JSON из</Run>
                        <Run FontStyle="Italic">%AppData%\HeatLossRevit2\data\snapshots_raw\</Run><LineBreak/>
                        <Run>2. Нагрузки подставятся автоматически (100 Вт/м², кратности).</Run>
                        <LineBreak/>
                        <Run>3. При необходимости правьте Q / расходы прямо в таблице —</Run>
                        <Run>при включённом «Живом пересчёте» план обновится сам.</Run><LineBreak/>
                        <Run>4. Настройте режимы и нажмите «РАССЧИТАТЬ».</Run><LineBreak/>
                        <Run>5. Проверьте план и таблицу; k_ef &lt; 0.6 — прибор недогружен,</Run>
                        <Run>&gt; 0.9 — перегружен.</Run><LineBreak/>
                        <Run>6. «HTML» — отчёт в браузере; «Проект» — сохранить/продолжить;</Run>
                        <Run>в Revit кнопка «Стенд расстановки» пишет в модель.</Run>
                    </TextBlock>
                </Expander>
            </DockPanel>
        </Border>

        <!-- ============ ПАНЕЛЬ ИНСТРУМЕНТОВ ============ -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBg}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="8,6">
            <WrapPanel VerticalAlignment="Center">
                <!-- Шаг 1: данные -->
                <Button Command="{Binding OpenSnapshotCommand}" FontWeight="SemiBold">
                    ① Открыть снимок…
                </Button>
                <Button Command="{Binding RecalcLoadsCommand}"
                        ToolTip="Вернуть нагрузки к авторасчёту (100 Вт/м², кратности)">
                    ↻ Нагрузки
                </Button>

                <Rectangle Width="1" Height="24" Fill="{StaticResource BorderBrush}" Margin="8,0"/>

                <!-- Правила -->
                <TextBlock Style="{StaticResource StepLabel}">Назначение:</TextBlock>
                <TextBox x:Name="PurposeBox" Style="{StaticResource InputBox}" Width="90"
                         Text="Office"/>
                <Button Command="{Binding ApplyPurposeCommand}"
                        CommandParameter="{Binding Text, ElementName=PurposeBox}">
                    Применить к уровню
                </Button>
                <Button Command="{Binding IncludeLevelCommand}"
                        ToolTip="Отметить «Включено» у всех помещений выбранного уровня">
                    ☑ Включить уровень
                </Button>
                <Button Command="{Binding IncludeOnlyVisibleCommand}"
                        ToolTip="Оставить включёнными только помещения, видимые в таблице">
                    ☐ Только видимые
                </Button>

                <Rectangle Width="1" Height="24" Fill="{StaticResource BorderBrush}" Margin="8,0"/>

                <TextBlock Style="{StaticResource StepLabel}">Доля от окна:</TextBlock>
                <TextBox Text="{Binding MinLengthRatio, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputBox}" Width="44"/>
                <TextBlock Style="{StaticResource StepLabel}">Приток:</TextBlock>
                <ComboBox ItemsSource="{Binding CountRules}" SelectedItem="{Binding SupplyRule}"
                          Width="105" Margin="2,0"/>
                <ComboBox ItemsSource="{Binding WallPatterns}" SelectedItem="{Binding SupplyPattern}"
                          Width="92" Margin="2,0"
                          ToolTip="Паттерн массовой расстановки притока: сетка по потолку / вдоль длинной стороны / вдоль короткой / явная сторона"/>
                <TextBlock Style="{StaticResource StepLabel}" Text="N="/>
                <TextBox Text="{Binding FixedSupplyCount, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputBox}" Width="36"/>
                <TextBlock Style="{StaticResource StepLabel}">Вытяжка:</TextBlock>
                <ComboBox ItemsSource="{Binding CountRules}" SelectedItem="{Binding ExhaustRule}"
                          Width="105" Margin="2,0"/>
                <ComboBox ItemsSource="{Binding WallPatterns}" SelectedItem="{Binding ExhaustPattern}"
                          Width="92" Margin="2,0"
                          ToolTip="Паттерн массовой расстановки вытяжки: сетка по потолку / вдоль длинной стороны / вдоль короткой / явная сторона"/>
                <TextBlock Style="{StaticResource StepLabel}">1 прибор:</TextBlock>
                <ComboBox ItemsSource="{Binding SingleRules}" SelectedItem="{Binding SingleDeviceRule}"
                          Width="80" Margin="2,0"
                          ToolTip="Где ставится одиночный прибор: в центре контура или в углу"/>
                <TextBlock Style="{StaticResource StepLabel}">v решётки:</TextBlock>
                <TextBox Text="{Binding GrilleVelocityMs, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputBox}" Width="40"/>
                <CheckBox Content="Живой пересчёт" IsChecked="{Binding LiveRecalc}"
                          VerticalAlignment="Center" Margin="10,0,0,0"/>

                <Rectangle Width="1" Height="24" Fill="{StaticResource BorderBrush}" Margin="8,0"/>

                <!-- Шаг 4: расчёт и вывод -->
                <Button Style="{StaticResource PrimaryButton}" Padding="16,6"
                        Command="{Binding CalculateCommand}"
                        ToolTip="Разместить отопление под окнами, приток сеткой по площади, вытяжку по расходу">
                    ▶ РАССЧИТАТЬ
                </Button>
                <Button Command="{Binding ExportHtmlCommand}"
                        ToolTip="Самодостаточный HTML со схемой и таблицей">
                    🌐 HTML
                </Button>
                <Button Command="{Binding ExportTaskCommand}"
                        ToolTip="JSON-задание в формате прототипа: S_ID, system_name, instance_points (мм)">
                    ⬇ Задание JSON
                </Button>
                <Button Command="{Binding SaveProjectCommand}" Content="💾 Сохранить проект"/>
                <Button Command="{Binding LoadProjectCommand}" Content="📂 Загрузить проект"/>

                <Rectangle Width="1" Height="24" Fill="{StaticResource BorderBrush}" Margin="8,0"/>

                <!-- U2.2: офлайн-каталог приборов -->
                <Button Command="{Binding EditCatalogCommand}"
                        ToolTip="Редактировать каталог приборов (JSON, офлайн): типоразмеры, расходы, мощности, габариты">
                    🗂 Каталог приборов…
                </Button>
            </WrapPanel>
        </Border>

        <!-- ============ РАБОЧАЯ ОБЛАСТЬ ============ -->
        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Помещения -->
            <Border Grid.Column="0" Background="{StaticResource PanelBg}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="6" Margin="0,0,4,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Margin="10,8"
                               FontWeight="SemiBold" Foreground="{StaticResource TextDark}">
                        Помещения — редактируйте Q, приток, вытяжку и назначение
                    </TextBlock>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding RoomsView}"
                              Margin="6,0,6,6" BorderThickness="1">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="☑"
                                Binding="{Binding IsIncluded, UpdateSourceTrigger=PropertyChanged}"
                                Width="34"/>
                            <DataGridTextColumn Header="№" Binding="{Binding Number}" Width="45"/>
                            <DataGridTextColumn Header="Помещение" Binding="{Binding Name}" Width="140"/>
                            <DataGridTextColumn Header="Уровень" Binding="{Binding LevelName}" Width="85"/>
                            <DataGridTextColumn Header="S, м²" Binding="{Binding Area, StringFormat=F1}" Width="60"/>
                            <DataGridCheckBoxColumn Header="Угл." Binding="{Binding IsCorner}" Width="45"/>
                            <DataGridTextColumn Header="Назначение" Binding="{Binding Purpose}" Width="95"/>
                            <DataGridTextColumn Header="Q, Вт" Binding="{Binding HeatingW}" Width="85"/>
                            <DataGridTextColumn Header="Приток, м³/ч" Binding="{Binding Supply}" Width="85"/>
                            <DataGridTextColumn Header="Вытяжка, м³/ч" Binding="{Binding Exhaust}" Width="90"/>
                            <DataGridTextColumn Header="Системы" Binding="{Binding SystemsSummary, Mode=OneWay}" IsReadOnly="True" Width="95"/>
                            <DataGridTemplateColumn Width="82">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Системы…" Padding="4,1"
                                                Click="EditSystems_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Примечание" Binding="{Binding Warning}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Пустое состояние -->
                    <Border Grid.RowSpan="2" Background="#FBFCFE">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasRooms}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="Нет данных" FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource TextMuted}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock TextAlignment="Center" Margin="0,10,0,0"
                                       Foreground="{StaticResource TextMuted}" LineHeight="20">
                                Нажмите «① Открыть снимок…» и выберите JSON-файл,<LineBreak/>
                                например:<LineBreak/>
                                <Run FontStyle="Italic">%AppData%\HeatLossRevit2\data\snapshots_raw\…\*.json</Run><LineBreak/>
                                <LineBreak/>
                                Помещения, нагрузки и режимы появятся автоматически.
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- План + размещения -->
            <Grid Grid.Column="1" Margin="4,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource PanelBg}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="6">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="4,4,4,6">
                            <TextBlock FontWeight="SemiBold"
                                       Foreground="{StaticResource TextDark}">План уровня:</TextBlock>
                            <ComboBox ItemsSource="{Binding Levels}"
                                      SelectedItem="{Binding SelectedLevel}"
                                      Width="170" Margin="8,0,0,0"
                                      HorizontalAlignment="Left"/>
                        </DockPanel>
                        <oxy:PlotView Model="{Binding PlotModel}"/>
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" Background="{StaticResource PanelBg}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="6" Margin="0,6,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Margin="4,4,4,6" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextDark}">
                            Размещённые приборы (k_ef: &lt;0.6 недогруз · 0.6–0.9 норма · &gt;0.9 перегруз)
                        </TextBlock>
                        <DataGrid ItemsSource="{Binding Placements}" BorderThickness="1">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Помещение" Binding="{Binding RoomName}" Width="120"/>
                                <DataGridTextColumn Header="Уровень" Binding="{Binding LevelName}" Width="85"/>
                                <DataGridTextColumn Header="Прибор" Binding="{Binding Family}" Width="90"/>
                                <DataGridTextColumn Header="Типоразмер" Binding="{Binding TypeName}" Width="130"/>
                                <DataGridTextColumn Header="Система" Binding="{Binding SystemName}" Width="80"/>
                                <DataGridTextColumn Header="Расход, м³/ч" Binding="{Binding CalculatedFlow, StringFormat=F1}" Width="90"/>
                                <DataGridTextColumn Header="X, мм" Binding="{Binding X}" Width="80"/>
                                <DataGridTextColumn Header="Y, мм" Binding="{Binding Y}" Width="80"/>
                                <DataGridTextColumn Header="Поворот°" Binding="{Binding RotationDeg}" Width="65"/>
                                <!-- U3.1: k_ef цветом по порогам <0.6 / 0.6–0.9 / >0.9 -->
                                <DataGridTextColumn Header="k_ef" Binding="{Binding KEf, StringFormat=F2}" Width="55">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding KefStatus}" Value="low">
                                                    <Setter Property="Foreground" Value="#E67E22"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding KefStatus}" Value="ok">
                                                    <Setter Property="Foreground" Value="#1E8E3E"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding KefStatus}" Value="high">
                                                    <Setter Property="Foreground" Value="#D93025"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
