<Window x:Class="HVACLoadTerminals.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:HVACLoadTerminals.App.ViewModels"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="HVAC Terminals · Расстановка приборов по снимку помещений"
        Height="900" Width="1500"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <SolidColorBrush x:Key="PrimaryBrush" Color="#2D6CDF"/>
        <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#1B4FA8"/>
        <SolidColorBrush x:Key="PanelBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#D5DBE3"/>
        <SolidColorBrush x:Key="TextDark" Color="#212B36"/>
        <SolidColorBrush x:Key="TextMuted" Color="#637381"/>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EDF2FC"/>
                                <Setter TargetName="bd" Property="BorderBrush"
                                        Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#DCE7FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryDarkBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{StaticResource PrimaryDarkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#B9C6DE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StepLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10,0,3,0"/>
        </Style>

        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="42"/>
            <Setter Property="Margin" Value="2,0"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AlternatingRowBackground" Value="#F7F9FC"/>
            <Setter Property="RowHeight" Value="26"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EEF1F5"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource PrimaryDarkBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="BorderBrush" Value="#163A78"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ============ СТАТУСНАЯ СТРОКА ============ -->
        <StatusBar DockPanel.Dock="Bottom" Background="#EAEFF6">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextDark}"/>
        </StatusBar>

        <!-- ============ ЗАГОЛОВОК ============ -->
        <Border DockPanel.Dock="Top" Background="#1F2A44" Padding="14,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="HVAC Terminals" FontSize="18" FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock Text="  ·  расстановка приборов по снимку помещений"
                               FontSize="13" Foreground="#AEBBD4"
                               VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                </StackPanel>
                <Expander DockPanel.Dock="Right" Header="Как пользоваться?"
                          Foreground="White" ExpandDirection="Down" Width="360"
                          HorizontalAlignment="Right" Background="#26334F" Padding="6">
                    <TextBlock Foreground="#D9E1F2" FontSize="12" LineHeight="18" TextWrapping="Wrap">
                        <Run>1. «Открыть снимок…» — выбрать JSON из</Run>
                        <Run FontStyle="Italic">%AppData%\HeatLossRevit2\data\snapshots_raw\</Run><LineBreak/>
                        <Run>2. Нагрузки подставятся автоматически (100 Вт/м², кратности).</Run>
                        <LineBreak/>
                        <Run>3. При необходимости правьте Q / расходы прямо в таблице —</Run>
                        <Run>при включённом «Живом пересчёте» план обновится сам.</Run><LineBreak/>
                        <Run>4. Настройте режимы и нажмите «РАССЧИТАТЬ».</Run><LineBreak/>
                        <Run>5. Проверьте план и таблицу; k_ef &lt; 0.6 — прибор недогружен,</Run>
                        <Run>&gt; 0.9 — перегружен.</Run><LineBreak/>
                        <Run>6. «HTML» — отчёт в браузере; «Проект» — сохранить/продолжить;</Run>
                        <Run>в Revit кнопка «Стенд расстановки» пишет в модель.</Run>
                    </TextBlock>
                </Expander>
            </DockPanel>
        </Border>

        <!-- ============ ПАНЕЛЬ ИНСТРУМЕНТОВ ============ -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBg}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="8,6">
            <WrapPanel VerticalAlignment="Center">
                <!-- Шаг 1: данные -->
                <Button Command="{Binding OpenSnapshotCommand}" FontWeight="SemiBold">
                    ① Открыть снимок…
                </Button>
                <Button Command="{Binding RecalcLoadsCommand}"
                        ToolTip="Вернуть нагрузки к авторасчёту (100 Вт/м², кратности)">
                    ↻ Нагрузки
                </Button>

                <Rectangle Width="1" Height="24" Fill="{StaticResource BorderBrush}" Margin="8,0"/>

                <!-- Правила -->
                <TextBlock Style="{StaticResource StepLabel}">Назначение:</TextBlock>
                <TextBox x:Name="PurposeBox" Style="{StaticResource InputBox}" Width="90"
                         Text="Office"/>
                <Button Command="{Binding ApplyPurposeCommand}"
                        CommandParameter="{Binding Text, ElementName=PurposeBox}">
                    Применить к уровню
                </Button>
                <Button Command="{Binding IncludeLevelCommand}"
                        ToolTip="Отметить «Включено» у всех помещений выбранного уровня">
                    ☑ Включить уровень
                </Button>
                <Button Command="{Binding IncludeOnlyVisibleCommand}"
                        ToolTip="Оставить включёнными только помещения, видимые в таблице">
                    ☐ Только видимые
                </Button>
                <Button Command="{Binding ApplyMassCommand}"
                        ToolTip="Detail-режим: применить типоразмер/правило/паттерн/отступы к выделенным помещениям (Ctrl/Shift)">
                    ⚙ К выбранным…
                </Button>

                <Rectangle Width="1" Height="24" Fill="{StaticResource BorderBrush}" Margin="8,0"/>

                <TextBlock Style="{StaticResource StepLabel}">Доля от окна:</TextBlock>
                <TextBox Text="{Binding MinLengthRatio, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputBox}" Width="44"/>
                <TextBlock Style="{StaticResource StepLabel}">Приток:</TextBlock>
                <ComboBox ItemsSource="{Binding CountRules}" SelectedItem="{Binding SupplyRule}"
                          Width="105" Margin="2,0"/>
                <ComboBox ItemsSource="{Binding WallPatterns}" SelectedItem="{Binding SupplyPattern}"
                          Width="92" Margin="2,0"
                          ToolTip="Паттерн массовой расстановки притока: сетка по потолку / вдоль длинной стороны / вдоль короткой / явная сторона"/>
                <TextBlock Style="{StaticResource StepLabel}" Text="N="/>
                <TextBox Text="{Binding FixedSupplyCount, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputBox}" Width="36"/>
                <TextBlock Style="{StaticResource StepLabel}">Вытяжка:</TextBlock>
                <ComboBox ItemsSource="{Binding CountRules}" SelectedItem="{Binding ExhaustRule}"
                          Width="105" Margin="2,0"/>
                <ComboBox ItemsSource="{Binding WallPatterns}" SelectedItem="{Binding ExhaustPattern}"
                          Width="92" Margin="2,0"
                          ToolTip="Паттерн массовой расстановки вытяжки: сетка по потолку / вдоль длинной стороны / вдоль короткой / явная сторона"/>
                <TextBlock Style="{StaticResource StepLabel}">1 прибор:</TextBlock>
                <ComboBox ItemsSource="{Binding SingleRules}" SelectedItem="{Binding SingleDeviceRule}"
                          Width="80" Margin="2,0"
                          ToolTip="Где ставится одиночный прибор: в центре контура или в углу"/>
                <TextBlock Style="{StaticResource StepLabel}">v решётки:</TextBlock>
                <TextBox Text="{Binding GrilleVelocityMs, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputBox}" Width="40"/>
                <CheckBox Content="Живой пересчёт" IsChecked="{Binding LiveRecalc}"
                          VerticalAlignment="Center" Margin="10,0,0,0"/>

                <Rectangle Width="1" Height="24" Fill="{StaticResource BorderBrush}" Margin="8,0"/>

                <!-- Шаг 4: расчёт и вывод -->
                <Button Style="{StaticResource PrimaryButton}" Padding="16,6"
                        Command="{Binding CalculateCommand}"
                        ToolTip="Разместить отопление под окнами, приток сеткой по площади, вытяжку по расходу">
                    ▶ РАССЧИТАТЬ
                </Button>
                <Button Command="{Binding ExportHtmlCommand}"
                        ToolTip="Самодостаточный HTML со схемой и таблицей">
                    🌐 HTML
                </Button>
                <Button Command="{Binding ExportTaskCommand}"
                        ToolTip="JSON в схеме прототипа (S_ID/system_name/instance_points, мм)">
                    ⬇ Задание JSON
                </Button>
                <Button Command="{Binding ExportExcelCommand}" Margin="3"
                        ToolTip="Excel-отчёт: лист level_values (сводка по помещениям×системам) + лист Приборы">
                    ⬇ Excel
                </Button>
                <Button Command="{Binding ExportReportCommand}"
                        ToolTip="HTML-отчёт по уровню: интерактивная схема + сводка систем + таблица приборов">
                    📄 Отчёт
                </Button>
                <Button Command="{Binding SaveProjectCommand}" Content="💾 Сохранить проект"/>
                <Button Command="{Binding LoadProjectCommand}" Content="📂 Загрузить проект"/>

                <Rectangle Width="1" Height="24" Fill="{StaticResource BorderBrush}" Margin="8,0"/>

                <!-- U2.2: офлайн-каталог приборов -->
                <Button Command="{Binding EditCatalogCommand}"
                        ToolTip="Редактировать каталог приборов (JSON, офлайн): типоразмеры, расходы, мощности, габариты">
                    🗂 Каталог приборов…
                </Button>
            </WrapPanel>
        </Border>

        <!-- ============ РАБОЧАЯ ОБЛАСТЬ (M1.1 CRM-каркас) ============ -->
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="1.3*"/>
            </Grid.RowDefinitions>

            <!-- Верхний ряд: дерево / табы 2D+3D / свойства -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <!-- Дерево Системы → Уровни → Помещения -->
                <Border Grid.Column="0" Background="{StaticResource PanelBg}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="6" Margin="0,0,4,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Margin="10,8" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextDark}">Системы проекта</TextBlock>
                        <TreeView ItemsSource="{Binding TreeRoots}"
                                  SelectedItemChanged="CrmTree_SelectedItemChanged"
                                  Margin="4,0,4,6" BorderThickness="0">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}"/>
                                        <TextBlock Text="{Binding CountText, Mode=OneWay}"
                                                   Foreground="{StaticResource TextMuted}"
                                                   FontSize="11" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="Padding" Value="2,1"/>
                                    <Setter Property="IsExpanded" Value="True"/>
                                </Style>
                            </TreeView.ItemContainerStyle>
                        </TreeView>
                    </DockPanel>
                </Border>

                <!-- Центр: табы План 2D / 3D -->
                <Border Grid.Column="1" Background="{StaticResource PanelBg}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="6">
                    <TabControl x:Name="CenterTabs" SelectionChanged="CenterTabs_SelectionChanged"
                                BorderThickness="0" Background="Transparent">
                        <TabItem Header="План 2D">
                            <DockPanel Margin="4">
                                <DockPanel DockPanel.Dock="Top" Margin="2,2,2,6">
                                    <ComboBox ItemsSource="{Binding Levels}"
                                              SelectedItem="{Binding SelectedLevel}"
                                              Width="150" Margin="0,0,8,0"
                                              HorizontalAlignment="Left"/>
                                    <TextBlock Text="Цвета:" VerticalAlignment="Center" Margin="0,0,4,0"
                                               Foreground="{StaticResource TextMuted}"/>
                                    <ComboBox ItemsSource="{Binding PlanColorModes}"
                                              SelectedItem="{Binding SelectedColorMode}"
                                              Width="120" VerticalContentAlignment="Center"
                                              HorizontalAlignment="Left"/>
                                    <CheckBox Content="Подписи комнат" IsChecked="{Binding ShowRoomLabels}"
                                              VerticalAlignment="Center" Margin="12,0,0,0"
                                              HorizontalAlignment="Left"/>
                                </DockPanel>
                                <oxy:PlotView Model="{Binding PlotModel}"/>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="3D">
                            <wv2:WebView2 x:Name="Web3D"/>
                        </TabItem>
                    </TabControl>
                </Border>

                <!-- Свойства выбранного узла (M2.1: редактирование системы) -->
                <Border Grid.Column="2" Background="{StaticResource PanelBg}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="6" Margin="4,0,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Margin="10,8" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextDark}">Свойства</TextBlock>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10,4,10,8">
                                <TextBlock Text="{Binding SelectedNode.Title, TargetNullValue=Выберите систему слева}"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextDark}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SelectedSystem.TypeText}"
                                           Margin="0,2,0,8" FontSize="11"
                                           Foreground="{StaticResource TextMuted}"/>
                                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,4"/>

                                <!-- M2.1: редактор свойств системы (не отопление) -->
                                <StackPanel Visibility="{Binding SelectedSystem.ShowEditing,
                                                        Converter={StaticResource BoolToVis}}">
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}">Имя системы</TextBlock>
                                    <DockPanel Margin="0,1,0,10">
                                        <Button DockPanel.Dock="Right" Content="✓"
                                                Command="{Binding SelectedSystem.ApplyNameCommand}"
                                                ToolTip="Переименовать систему во всех помещениях"
                                                Padding="8,3" Margin="4,0,0,0"/>
                                        <TextBox Text="{Binding SelectedSystem.NameEditor, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="5,3" VerticalContentAlignment="Center"/>
                                    </DockPanel>

                                    <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}">Типоразмер прибора</TextBlock>
                                    <ComboBox ItemsSource="{Binding SelectedSystem.Devices}"
                                              SelectedItem="{Binding SelectedSystem.SelectedDevice}"
                                              DisplayMemberPath="Label" Margin="0,1,0,2"/>
                                    <TextBlock Text="{Binding SelectedSystem.DeviceInfoText}"
                                               FontSize="11" LineHeight="15" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextMuted}" Margin="0,0,0,10"/>

                                    <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}">Правило количества</TextBlock>
                                    <Grid Margin="0,1,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox ItemsSource="{Binding SelectedSystem.Rules}"
                                                  SelectedItem="{Binding SelectedSystem.Rule}"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding SelectedSystem.IsFixedVisible,
                                                                 Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="N=" VerticalAlignment="Center" Margin="8,0,2,0"
                                                       Foreground="{StaticResource TextMuted}"/>
                                            <TextBox Width="42" Padding="4,2"
                                                     Text="{Binding SelectedSystem.FixedCount, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Фиксированное число приборов в помещении"/>
                                        </StackPanel>
                                    </Grid>
                                    <!-- N-калькулятор: почему такое количество приборов -->
                                    <TextBlock Text="{Binding SelectedSystem.FormulaText}"
                                               FontSize="11" LineHeight="15" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextDark}" Margin="0,0,0,10"/>

                                    <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}">Паттерн расстановки</TextBlock>
                                    <ComboBox ItemsSource="{Binding SelectedSystem.Patterns}"
                                              SelectedItem="{Binding SelectedSystem.Pattern}" Margin="0,1,0,6"/>
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}">Одиночный прибор</TextBlock>
                                    <ComboBox ItemsSource="{Binding SelectedSystem.SingleRules}"
                                              SelectedItem="{Binding SelectedSystem.SinglePlacementRule}" Margin="0,1,0,8"/>

                                    <!-- M2.2: отступы размещения -->
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}">Отступы размещения, мм</TextBlock>
                                    <Grid Margin="0,1,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="От стен:" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextMuted}" Margin="0,0,4,0"/>
                                        <TextBox Grid.Column="1" Padding="4,2"
                                                 Text="{Binding SelectedSystem.EdgeOffsetMm, TargetNullValue=''}"
                                                 ToolTip="Смещение зоны размещения от стен внутрь помещения (buffer(-x)). Пусто — по типоразмеру/500 мм"/>
                                        <TextBlock Grid.Column="2" Text="От потолка:" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextMuted}" Margin="8,0,4,0"/>
                                        <TextBox Grid.Column="3" Padding="4,2"
                                                 Text="{Binding SelectedSystem.CeilingOffsetMm, TargetNullValue=''}"
                                                 ToolTip="Заглубление прибора от чистого потолка; высота установки = H потолка − offset. Пусто — по типоразмеру"/>
                                    </Grid>
                                    <TextBlock Text="{Binding SelectedSystem.EdgeOffsetText}"
                                               FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                                    <oxy:PlotView Model="{Binding SelectedSystem.SchemeModel}"
                                                  Height="140" Margin="0,0,0,8"/>
                                </StackPanel>

                                <!-- Итог по системе -->
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Помещений" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedSystem.RoomCount}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="1" Text="Приборов" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedSystem.DeviceCount}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="2" Text="Σ расход" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedSystem.FlowText}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="3" Text="k_ef средний" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedSystem.KefText}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="4" Text="Типоразмер" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedSystem.ActualDeviceText}"
                                               FontWeight="SemiBold" MaxWidth="190" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding SelectedSystem.ActualDeviceText}"/>
                                </Grid>

                                <!-- M2.3: свойства помещения -->
                                <StackPanel Visibility="{Binding HasSelectedRoom,
                                                        Converter={StaticResource BoolToVis}}"
                                            DataContext="{Binding SelectedRoom}">
                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Room.SystemsSummary}"
                                                   Foreground="{StaticResource TextMuted}" FontSize="11"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="Системы…" Padding="6,2"
                                                Click="EditSystemsPanel_Click"/>
                                    </Grid>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="70"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Q, Вт:" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextMuted}"/>
                                        <TextBox Grid.Column="1" Padding="4,2"
                                                 Text="{Binding Room.HeatingW, UpdateSourceTrigger=LostFocus}"/>
                                        <TextBlock Grid.Column="2" Text="t°:" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextMuted}" Margin="8,0,4,0"/>
                                        <TextBox Grid.Column="3" IsReadOnly="True"
                                                 Text="{Binding TemperatureText}" Background="#F7F9FC"/>
                                        <TextBlock Grid.Row="1" Text="Приток:" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextMuted}"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" Padding="4,2"
                                                 Text="{Binding Room.Supply, UpdateSourceTrigger=LostFocus}"/>
                                        <TextBlock Grid.Row="2" Text="Вытяжка:" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextMuted}"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" Padding="4,2"
                                                 Text="{Binding Room.Exhaust, UpdateSourceTrigger=LostFocus}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Назначение:"
                                                   VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"
                                                   Margin="8,0,4,0"/>
                                        <TextBox Grid.Row="1" Grid.Column="3" Padding="4,2"
                                                 Text="{Binding Room.Purpose, UpdateSourceTrigger=LostFocus}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Площадь:"
                                                   VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"
                                                   Margin="8,0,4,0"/>
                                        <TextBox Grid.Row="2" Grid.Column="3" IsReadOnly="True" Background="#F7F9FC"
                                                 Text="{Binding Room.Area, StringFormat=F1}"/>
                                    </Grid>
                                    <TextBlock Margin="0,10,0,0" FontSize="11"
                                               Foreground="{StaticResource TextMuted}"
                                               Text="Проёмы (из снимка)"/>
                                    <TextBlock Text="{Binding OpeningsText}" FontSize="11"
                                               LineHeight="15" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextDark}"/>
                                    <TextBlock Text="{Binding WindowForecastText}" FontSize="11"
                                               LineHeight="15" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Foreground="{StaticResource PrimaryDarkBrush}"/>
                                    <TextBlock Margin="0,10,0,0" FontSize="11"
                                               Foreground="{StaticResource TextMuted}"
                                               Text="Примечание расчёта"/>
                                    <TextBlock Text="{Binding Room.Warning}" FontSize="11"
                                               LineHeight="15" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextDark}"/>
                                </StackPanel>

                                <!-- Подсказка для не-системных узлов -->
                                <TextBlock Margin="0,10,0,0" FontSize="11" LineHeight="16"
                                           Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
                                           Text="Выберите узел слева: фильтр таблицы и плана. Правка свойств системы (типоразмер, правило количества, паттерны) — на ветках систем.">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasSelectedSystem}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Нижний ряд: помещения и приборы -->
            <Grid Grid.Row="1" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

            <!-- Помещения (низ-лево) -->
            <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource PanelBg}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="6" Margin="0,0,4,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Margin="10,8"
                               FontWeight="SemiBold" Foreground="{StaticResource TextDark}">
                        Помещения — редактируйте Q, приток, вытяжку и назначение
                    </TextBlock>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding RoomsView}"
                              Margin="6,0,6,6" BorderThickness="1"
                              SelectionMode="Extended" SelectionUnit="FullRow"
                              x:Name="RoomsGrid"
                              SelectionChanged="RoomsGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="☑"
                                Binding="{Binding IsIncluded, UpdateSourceTrigger=PropertyChanged}"
                                Width="34"/>
                            <DataGridTextColumn Header="№" Binding="{Binding Number}" Width="45"/>
                            <DataGridTextColumn Header="Помещение" Binding="{Binding Name}" Width="140"/>
                            <DataGridTextColumn Header="Уровень" Binding="{Binding LevelName}" Width="85"/>
                            <DataGridTextColumn Header="S, м²" Binding="{Binding Area, StringFormat=F1}" Width="60"/>
                            <DataGridCheckBoxColumn Header="Угл." Binding="{Binding IsCorner}" Width="45"/>
                            <DataGridTextColumn Header="Назначение" Binding="{Binding Purpose}" Width="95"/>
                            <DataGridTextColumn Header="Q, Вт" Binding="{Binding HeatingW}" Width="85"/>
                            <DataGridTextColumn Header="Приток, м³/ч" Binding="{Binding Supply}" Width="85"/>
                            <DataGridTextColumn Header="Вытяжка, м³/ч" Binding="{Binding Exhaust}" Width="90"/>
                            <DataGridTextColumn Header="Системы" Binding="{Binding SystemsSummary, Mode=OneWay}" IsReadOnly="True" Width="95"/>
                            <DataGridTemplateColumn Width="82">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Системы…" Padding="4,1"
                                                Click="EditSystems_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Примечание" Binding="{Binding Warning}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Пустое состояние -->
                    <Border Grid.RowSpan="2" Background="#FBFCFE">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasRooms}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="Нет данных" FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource TextMuted}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock TextAlignment="Center" Margin="0,10,0,0"
                                       Foreground="{StaticResource TextMuted}" LineHeight="20">
                                Нажмите «① Открыть снимок…» и выберите JSON-файл,<LineBreak/>
                                например:<LineBreak/>
                                <Run FontStyle="Italic">%AppData%\HeatLossRevit2\data\snapshots_raw\…\*.json</Run><LineBreak/>
                                <LineBreak/>
                                Помещения, нагрузки и режимы появятся автоматически.
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Приборы (низ-право), фильтруются деревом CRM -->
            <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource PanelBg}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="6" Margin="4,0,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="4,4,4,6" FontWeight="SemiBold"
                               Foreground="{StaticResource TextDark}">
                        Размещённые приборы (k_ef: &lt;0.6 недогруз · 0.6–0.9 норма · &gt;0.9 перегруз)
                    </TextBlock>
                    <DataGrid ItemsSource="{Binding PlacementsView}" BorderThickness="1">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Помещение" Binding="{Binding RoomName}" Width="120"/>
                                <DataGridTextColumn Header="Уровень" Binding="{Binding LevelName}" Width="85"/>
                                <DataGridTextColumn Header="Прибор" Binding="{Binding Family}" Width="90"/>
                                <DataGridTextColumn Header="Типоразмер" Binding="{Binding TypeName}" Width="130"/>
                                <DataGridTextColumn Header="Система" Binding="{Binding SystemName}" Width="80"/>
                                <DataGridTextColumn Header="Расход, м³/ч" Binding="{Binding CalculatedFlow, StringFormat=F1}" Width="90"/>
                                <DataGridTextColumn Header="Высота, мм" Binding="{Binding MountHeightMm}" Width="70"/>
                                <DataGridTextColumn Header="X, мм" Binding="{Binding X}" Width="80"/>
                                <DataGridTextColumn Header="Y, мм" Binding="{Binding Y}" Width="80"/>
                                <DataGridTextColumn Header="Поворот°" Binding="{Binding RotationDeg}" Width="65"/>
                                <!-- U3.1/M0.1: k_ef цветом по порогам, «—» когда неприменим -->
                                <DataGridTextColumn Header="k_ef" Binding="{Binding KEfText}" Width="55">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding KefStatus}" Value="low">
                                                    <Setter Property="Foreground" Value="#E67E22"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding KefStatus}" Value="ok">
                                                    <Setter Property="Foreground" Value="#1E8E3E"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding KefStatus}" Value="high">
                                                    <Setter Property="Foreground" Value="#D93025"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <!-- P2: правило количества — словарь прототипа -->
                                <DataGridTextColumn Header="Расчёт" Binding="{Binding CalculationOption}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
