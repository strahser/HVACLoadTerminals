<Window x:Class="HVACLoadTerminals.App.LevelsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Менеджер уровней"
        Height="460" Width="760"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F9">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2D6CDF"/>
        <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#1B4FA8"/>
        <SolidColorBrush x:Key="PanelBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#D5DBE3"/>
        <SolidColorBrush x:Key="TextDark" Color="#212B36"/>
        <SolidColorBrush x:Key="TextMuted" Color="#637381"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EDF2FC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryDarkBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryDarkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AlternatingRowBackground" Value="#F7F9FC"/>
            <Setter Property="RowHeight" Value="26"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EEF1F5"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource PrimaryDarkBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#1F2A44" Padding="12,8">
            <StackPanel>
                <TextBlock Text="Уровни проекта" FontSize="13" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Сводка по каждому уровню — помещения, площадь, нагрузки, назначенные системы. Двойной клик — показать уровень на плане." FontSize="11" Foreground="#AEBBD4" TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="8,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Закрыть" Click="Close_Click"/>
                    <Button Content="📍 Показать" Style="{StaticResource PrimaryButton}" Click="Show_Click" ToolTip="Показать выбранный уровень в главном окне"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="☑ Включить все на уровне" Click="Include_Click" ToolTip="Включить все помещения выбранного уровня"/>
                    <Button Content="☐ Исключить все" Click="Exclude_Click" ToolTip="Исключить все помещения выбранного уровня"/>
                    <Button Content="➕ Назначить систему…" Click="Assign_Click" ToolTip="Назначить систему всем помещениям уровня"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <DataGrid x:Name="LevelsGrid" Margin="8" BorderThickness="1" IsReadOnly="True" SelectionMode="Single" MouseDoubleClick="LevelsGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Уровень" Binding="{Binding LevelName}" Width="140"/>
                <DataGridTextColumn Header="Помещений" Binding="{Binding RoomCount}" Width="80"/>
                <DataGridTextColumn Header="S, м²" Binding="{Binding TotalArea, StringFormat=F1}" Width="75"/>
                <DataGridTextColumn Header="Q, кВт" Binding="{Binding TotalHeatingKw, StringFormat=F1}" Width="70"/>
                <DataGridTextColumn Header="Приток" Binding="{Binding TotalSupply, StringFormat=F0}" Width="75"/>
                <DataGridTextColumn Header="Вытяжка" Binding="{Binding TotalExhaust, StringFormat=F0}" Width="75"/>
                <DataGridTextColumn Header="С системами" Binding="{Binding WithSystems}" Width="85"/>
                <DataGridTextColumn Header="Без систем" Binding="{Binding WithoutSystems}" Width="85"/>
                <DataGridTextColumn Header="Включено" Binding="{Binding Included}" Width="75"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
