<Window x:Class="HVACLoadTerminals.Revit.UI.SnapshotPlacementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Стенд расстановки по снимку (modeless)"
        Height="700" Width="1250"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="3"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock x:Name="StatusText" Text="Готово"/>
        </StatusBar>

        <!-- U3.1: WrapPanel как в App — тулбар переносится, кнопки не обрезаются -->
        <WrapPanel DockPanel.Dock="Top" VerticalAlignment="Center" Margin="4">
            <Button Content="Открыть снимок…" Click="OpenSnapshot_Click"/>
            <Button Content="Нагрузки" Click="RegenLoads_Click"
                    ToolTip="Вернуть нагрузки к авторасчёту (100 Вт/м², кратности)"/>
            <TextBlock Text="Доля от окна:" VerticalAlignment="Center" Margin="10,0,3,0"/>
            <TextBox Text="{Binding MinWindowLengthRatio, UpdateSourceTrigger=PropertyChanged}"
                     Width="42" VerticalContentAlignment="Center" Padding="4,2"/>

            <!-- U3.1: паритет с App — назначение -->
            <TextBlock Text="Назначение:" VerticalAlignment="Center" Margin="10,0,3,0"/>
            <TextBox x:Name="PurposeBox" Text="Office" Width="80"
                     VerticalContentAlignment="Center" Padding="4,2"/>
            <Button Content="Применить к уровню"
                    Click="ApplyPurpose_Click"
                    ToolTip="Назначение для всех помещений снимка (на стенде нет фильтра уровня)"/>

            <TextBlock Text="Приток:" VerticalAlignment="Center" Margin="10,0,3,0"/>
            <ComboBox ItemsSource="{Binding CountRules}" SelectedItem="{Binding SupplyRule}"
                      Width="100"/>
            <ComboBox ItemsSource="{Binding WallPatterns}" SelectedItem="{Binding SupplyPattern}"
                      Width="90" Margin="2,0"
                      ToolTip="Паттерн притока: сетка по потолку / вдоль длинной стороны / вдоль короткой / явная сторона"/>
            <TextBlock Text="N=" VerticalAlignment="Center" Margin="8,0,2,0"/>
            <TextBox Text="{Binding FixedSupplyCount, UpdateSourceTrigger=PropertyChanged}"
                     Width="32" VerticalContentAlignment="Center" Padding="4,2"/>
            <TextBlock Text="Вытяжка:" VerticalAlignment="Center" Margin="10,0,3,0"/>
            <ComboBox ItemsSource="{Binding CountRules}" SelectedItem="{Binding ExhaustRule}"
                      Width="100"/>
            <ComboBox ItemsSource="{Binding WallPatterns}" SelectedItem="{Binding ExhaustPattern}"
                      Width="90" Margin="2,0"
                      ToolTip="Паттерн вытяжки: сетка по потолку / вдоль длинной стороны / вдоль короткой / явная сторона"/>
            <TextBlock Text="1 прибор:" VerticalAlignment="Center" Margin="10,0,3,0"/>
            <ComboBox ItemsSource="{Binding SingleRules}" SelectedItem="{Binding SingleDeviceRule}"
                      Width="80" Margin="2,0"
                      ToolTip="Где ставится одиночный прибор: в центре контура или в углу"/>

            <!-- U3.1: паритет с App — скорость в решётке -->
            <TextBlock Text="v решётки:" VerticalAlignment="Center" Margin="10,0,3,0"/>
            <TextBox Text="{Binding GrilleVelocityMs, UpdateSourceTrigger=PropertyChanged}"
                     Width="36" VerticalContentAlignment="Center" Padding="4,2"
                     ToolTip="Скорость воздуха в решётке для подбора размера, м/с"/>

            <CheckBox Content="Живой пересчёт" IsChecked="{Binding LiveRecalc}"
                      VerticalAlignment="Center" Margin="10,0,0,0"
                      ToolTip="Автопересчёт после правок Q/расходов (коалесинг 300 мс)"/>
            <Button Content="▶ Рассчитать" Click="Calculate_Click" FontWeight="Bold"/>
            <!-- U3.1: паритет с App — сохранить/загрузить проект, HTML -->
            <Button Content="💾 Сохранить проект" Click="SaveProject_Click"/>
            <Button Content="📂 Загрузить проект" Click="LoadProject_Click"/>
            <Button Content="🌐 HTML" Click="ExportHtml_Click"
                    ToolTip="Самодостаточный HTML со схемой и таблицей (WebView2/браузер)"/>
            <Button Content="✔ Записать в модель (ExternalEvent)"
                    Click="Place_Click" Background="#E8F5E9" FontWeight="Bold"/>
        </WrapPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DataGrid Grid.Row="0" x:Name="RoomsGrid"
                      AutoGenerateColumns="False" CanUserAddRows="False"
                      AlternatingRowBackground="#FAFAFA">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="☑"
                        Binding="{Binding IsIncluded, UpdateSourceTrigger=PropertyChanged}"
                        Width="34"/>
                    <DataGridTextColumn Header="№" Binding="{Binding Number}" Width="45"/>
                    <DataGridTextColumn Header="Помещение" Binding="{Binding Name}" Width="140"/>
                    <DataGridTextColumn Header="Уровень" Binding="{Binding LevelName}" Width="90"/>
                    <DataGridTextColumn Header="S, м²" Binding="{Binding Area, StringFormat=F1}" Width="60"/>
                    <DataGridCheckBoxColumn Header="Угл." Binding="{Binding IsCorner}" Width="42"/>
                    <DataGridTextColumn Header="Назначение" Binding="{Binding Purpose}" Width="90"/>
                    <DataGridTextColumn Header="Q, Вт" Binding="{Binding HeatingW}" Width="80"/>
                    <DataGridTextColumn Header="Приток" Binding="{Binding Supply}" Width="70"/>
                    <DataGridTextColumn Header="Вытяжка" Binding="{Binding Exhaust}" Width="70"/>
                    <DataGridTextColumn Header="Примечание" Binding="{Binding Warning}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <DataGrid Grid.Row="1" x:Name="PlacementsGrid"
                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                      AlternatingRowBackground="#FAFAFA" Margin="0,4,0,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Помещение" Binding="{Binding RoomName}" Width="120"/>
                    <DataGridTextColumn Header="Уровень" Binding="{Binding LevelName}" Width="85"/>
                    <DataGridTextColumn Header="Прибор" Binding="{Binding Family}" Width="90"/>
                    <DataGridTextColumn Header="Типоразмер" Binding="{Binding TypeName}" Width="130"/>
                    <DataGridTextColumn Header="Система" Binding="{Binding SystemName}" Width="80"/>
                    <DataGridTextColumn Header="X, мм" Binding="{Binding X}" Width="80"/>
                    <DataGridTextColumn Header="Y, мм" Binding="{Binding Y}" Width="80"/>
                    <DataGridTextColumn Header="Поворот°" Binding="{Binding RotationDeg}" Width="65"/>
                    <!-- U3.1: k_ef цветом по порогам <0.6 / 0.6–0.9 / >0.9 -->
                    <DataGridTextColumn Header="k_ef" Binding="{Binding KEf, StringFormat=F2}" Width="55">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding KefStatus}" Value="low">
                                        <Setter Property="Foreground" Value="#E67E22"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding KefStatus}" Value="ok">
                                        <Setter Property="Foreground" Value="#1E8E3E"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding KefStatus}" Value="high">
                                        <Setter Property="Foreground" Value="#D93025"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</Window>
