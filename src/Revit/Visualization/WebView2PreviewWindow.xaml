<Window x:Class="HVACLoadTerminals.Revit.Visualization.WebView2PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Height="760" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#0d1117">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#161b22" Padding="8,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button x:Name="ApplyButton"
                            Content="Apply"
                            Padding="16,6" Margin="4"
                            Background="#238636" Foreground="White"
                            BorderThickness="0" Cursor="Hand"
                            Click="Apply_Click" />
                    <Button x:Name="CancelButton"
                            Content="Cancel"
                            Padding="16,6" Margin="4"
                            Background="#30363d" Foreground="#e6edf3"
                            BorderThickness="0" Cursor="Hand"
                            Click="Cancel_Click" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Right"
                           x:Name="StatusText"
                           VerticalAlignment="Center"
                           Margin="8,0"
                           Foreground="#888888"
                           Text="WebView2: initializing..." />
            </DockPanel>
        </Border>

        <!-- WebView2 surface -->
        <wv2:WebView2 x:Name="WebView" Grid.Row="1" />

        <!-- Hint -->
        <Border Grid.Row="2" Background="#161b22" Padding="8,6">
            <TextBlock Foreground="#8b949e"
                       Text="This preview communicates with Revit through WebView2 postMessage: click Apply to place the terminals or Cancel to go back." />
        </Border>
    </Grid>
</Window>