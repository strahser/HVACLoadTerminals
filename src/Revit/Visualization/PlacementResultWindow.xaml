<Window x:Class="HVACLoadTerminals.Revit.Visualization.PlacementResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Terminal Placement Result"
        Height="560" Width="860"
        WindowStartupLocation="CenterScreen"
        Background="#0d1117">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#161b22" Padding="12,10">
            <StackPanel>
                <TextBlock x:Name="TitleText"
                           Foreground="#58a6ff" FontSize="16" FontWeight="SemiBold" />
                <TextBlock x:Name="SummaryText"
                           Foreground="#8b949e" FontSize="12" Margin="0,4,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Rooms summary -->
        <ListView Grid.Row="1"
                  x:Name="RoomsList"
                  Background="#0d1117"
                  BorderBrush="#30363d"
                  Foreground="#e6edf3"
                  Margin="10"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#21262d" BorderThickness="0,0,0,1"
                            Padding="8,6" Margin="0,0,0,2">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding RoomName}"
                                           Foreground="#e6edf3" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="{Binding PlacementCount, StringFormat='  ·  {0} terminals'}"
                                           Foreground="#8b949e" FontSize="12"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding SystemsSummary}"
                                       Foreground="#8b949e" FontSize="11"
                                       Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Buttons -->
        <Border Grid.Row="2" Background="#161b22" Padding="10,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton"
                        Content="Cancel"
                        Padding="18,7" Margin="6"
                        Background="#30363d" Foreground="#e6edf3"
                        BorderThickness="0" Cursor="Hand"
                        Click="Cancel_Click" />
                <Button x:Name="ApplyButton"
                        Content="Place in Revit"
                        Padding="18,7" Margin="6"
                        Background="#238636" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        Click="Apply_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
