<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>HVACLoadTerminals.Revit</RootNamespace>
    <AssemblyName>HVACLoadTerminals.Revit</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>C:\Program Files\Autodesk\Revit 2024\RevitAPI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>C:\Program Files\Autodesk\Revit 2024\RevitAPIUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Core\HVACLoadTerminals.Core.csproj" />
    <ProjectReference Include="..\Infrastructure\HVACLoadTerminals.Infrastructure.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Папка плагинов Revit 2024 (можно переопределить: -p:RevitAddinsDir="...") -->
    <RevitAddinsDir Condition="'$(RevitAddinsDir)' == ''">$(ALLUSERSPROFILE)\Autodesk\Revit\Addins\2024</RevitAddinsDir>
  </PropertyGroup>

  <!-- Автокопирование сборки и .addin в папку плагинов Revit после сборки -->
  <ItemGroup>
    <RevitAddinFiles Include="$(TargetDir)*.dll;$(TargetDir)*.pdb" />
    <RevitAddinNative64 Include="$(TargetDir)x64\*.*" Condition="Exists('$(TargetDir)x64')" />
    <RevitAddinNative86 Include="$(TargetDir)x86\*.*" Condition="Exists('$(TargetDir)x86')" />
  </ItemGroup>
  <Target Name="CopyToRevitAddins" AfterTargets="Build" Condition="Exists('$(RevitAddinsDir)')">
    <Message Importance="high" Text="[HVAC] Copying add-in files to $(RevitAddinsDir)\HVACLoadTerminals" />
    <Copy SourceFiles="@(RevitAddinFiles)"
          DestinationFolder="$(RevitAddinsDir)\HVACLoadTerminals"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(RevitAddinNative64)"
          DestinationFolder="$(RevitAddinsDir)\HVACLoadTerminals\x64"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(RevitAddinNative86)"
          DestinationFolder="$(RevitAddinsDir)\HVACLoadTerminals\x86"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\HVACLoadTerminals.addin"
          DestinationFolder="$(RevitAddinsDir)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
