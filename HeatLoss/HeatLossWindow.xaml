<Window x:Class="HVACLoadTerminals.HeatLoss.RoomBoundingWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:HVACLoadTerminals.Views"
             xmlns:viewmodels="clr-namespace:HVACLoadTerminals.ViewModels"
             xmlns:drawNewSpaceFaces="clr-namespace:HVACLoadTerminals.DrawNewSpaceFaces"
             xmlns:heatLoss="clr-namespace:HVACLoadTerminals.HeatLoss"
             d:DataContext="{d:DesignInstance Type=heatLoss:HeatLossTableViewModel}"
             mc:Ignorable="d"
             Title="Теплопотери помещений"
             Height="600"
             Width="900"
             WindowStartupLocation="CenterScreen"
             FontFamily="Segoe UI"
             FontSize="14"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Auto"
             Background="#F0F0F0"
             WindowState="Maximized"> <!-- Добавлено свойство WindowState -->

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HVACLoadTerminals;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- DataGrid Styles -->
            <Style TargetType="DataGrid">
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="#CCCCCC"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="RowHeight" Value="30"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="AlternatingRowBackground" Value="#F9F9F9"/>
            </Style>
            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="#E0E0E0"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="Padding" Value="5"/>
            </Style>
            <Style TargetType="DataGridCell">
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="5"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="20,10,20,10">
                <TextBlock Text="Теплотехнический расчет"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10"/>
                <!-- Consider adding a ComboBox/RadioButtons here for North direction -->
                <Button Command="{Binding CreateFacesCommand}"
                        Content="Пересчитать Данные"
                        Padding="10,5"
                        Margin="0,0,0,10"
                        Style="{StaticResource {x:Type Button}}"/>
                <Button Command="{Binding SetRoomHeatLoadsCommand}"
                        Content="Установить теплопотери"
                        Padding="10,5"
                        Style="{StaticResource {x:Type Button}}"/>
                <Button Command="{Binding ExportToDocxCommand}"
                        Content="Экспортировать в DOCX"  
                        Padding="10,5"
                        Margin="0,0,0,10"
                        Style="{StaticResource {x:Type Button}}"/>  <!-- Применяем стиль кнопки -->
            </StackPanel>

            <ScrollViewer DockPanel.Dock="Bottom"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <DataGrid ItemsSource="{Binding FaceDataList}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserSortColumns="True"
                          GridLinesVisibility="None"
                          HeadersVisibility="Column"
                          ColumnWidth="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID Пространства"
                                            Binding="{Binding SpaceId}"
                                            Width="Auto"/>
                        <DataGridTextColumn Header="Номер Помещения"
                                            Binding="{Binding RoomNumber}"
                                            Width="Auto"/>
                        <DataGridTextColumn Header="Тип Конструкции"
                                            Binding="{Binding EnclosureType}"
                                            Width="Auto"/>
                        <DataGridTextColumn Header="Коэф. Теплопередачи"
                                            Binding="{Binding TransferCoefficient}"
                                            Width="Auto"/>
                        <DataGridTextColumn Header="Ориентация"
                                            Binding="{Binding Orientation}"
                                            Width="Auto"/>
                        <DataGridTextColumn Header="Ор.знач."
                                            Binding="{Binding OrientationValue}"
                                            Width="Auto"/>
                        <DataGridTextColumn Header="Тип"
                                            Binding="{Binding ConstructionType}"
                                            Width="Auto"/>
                        <DataGridTextColumn Header="Площадь"
                                            Binding="{Binding ConstructionArea}"
                                            Width="Auto"/>
                        <DataGridTextColumn Header="Tвн"
                                            Binding="{Binding Tin}"
                                            Width="Auto"/>
                        <DataGridTextColumn Header="Tнар"
                                            Binding="{Binding Tout}"
                                            Width="Auto"/>
                        <DataGridTextColumn Header="Угл.пом"
                                            Binding="{Binding CornerValue}"
                                            Width="Auto"/>
                        <DataGridTextColumn Header="Огражд.контрукции, Вт"
                                            Binding="{Binding HeatLoad}"
                                            Width="Auto"/>
                        <DataGridTextColumn Header="Инфильтрация, Вт"
                                            Binding="{Binding InfiltrationLoad}"
                                            Width="Auto"/>
                        <DataGridTextColumn Header="Итого, Вт"
                                            Binding="{Binding TotalHeatLoad}"
                                            Width="Auto"/>
                        <!--<DataGridTextColumn Header="По помещению, Вт"
                                            Binding="{Binding Subtotal}"
                                            Width="Auto"/>-->
                    </DataGrid.Columns>
                </DataGrid>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>