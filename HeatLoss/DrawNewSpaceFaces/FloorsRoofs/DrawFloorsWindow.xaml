<Window x:Class="HVACLoadTerminals.HeatLoss.DrawNewSpaceFaces.FloorsRoofs.DrawFloorsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:floorsRoofs="clr-namespace:HVACLoadTerminals.HeatLoss.DrawNewSpaceFaces.FloorsRoofs"
        xmlns:local="clr-namespace:HVACLoadTerminals.HeatLoss.DrawNewSpaceFaces.FloorsRoofs" 
        mc:Ignorable="d"
        Title="Создание перекрытий/кровли" Height="500" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        FontFamily="Segoe UI"
        FontSize="14" 
        d:DataContext="{d:DesignInstance floorsRoofs:DrawFloorsViewModel}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HVACLoadTerminals;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        
            <local:EnumToBooleanConverter x:Key="EnumToBooleanConverter"/>
            <local:VisibilityConverter x:Key="VisibilityConverter"/>
            <local:StringToBooleanConverter x:Key="StringToBooleanConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Text="Создание перекрытий и кровель" Grid.Row="0"/>

        <!-- Выбор типа (пол/кровля) -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10">
            <RadioButton Content="Пол" GroupName="EnclosureType" 
                         IsChecked="{Binding SelectedEnclosureType, Converter={StaticResource StringToBooleanConverter}, ConverterParameter=Floor}"/>
            <RadioButton Content="Кровля" GroupName="EnclosureType" Margin="10,0"
                         IsChecked="{Binding SelectedEnclosureType, Converter={StaticResource StringToBooleanConverter}, ConverterParameter=Roof}"/>
        </StackPanel>

        <!-- Выбор основного режима -->
        <ComboBox Grid.Row="2" Margin="0,10" 
                 ItemsSource="{Binding MainModes}" 
                 SelectedItem="{Binding SelectedMainMode}"
                 DisplayMemberPath="Description"/>

        <!-- Режим 1: Выбор уровней -->
        <GroupBox Header="Уровни" Grid.Row="3" Margin="0,10"
                  Visibility="{Binding SelectedMainMode.Type, Converter={StaticResource VisibilityConverter}, ConverterParameter=Mode1}">
            <StackPanel>
                <Label Content="Уровень пространств:"/>
                <ComboBox ItemsSource="{Binding Levels}" SelectedItem="{Binding SelectedSpaceLevel}" DisplayMemberPath="Name"/>
                <Label Content="Уровень отрисовки:" Margin="0,5"/>
                <ComboBox ItemsSource="{Binding Levels}" SelectedItem="{Binding SelectedLevelForDrawing}" DisplayMemberPath="Name"/>
            </StackPanel>
        </GroupBox>

        <!-- Режим 2: Ручной выбор -->
        <StackPanel Grid.Row="4" Margin="0,10"
                    Visibility="{Binding SelectedMainMode.Type, Converter={StaticResource VisibilityConverter}, ConverterParameter=Mode2}">
            <ComboBox ItemsSource="{Binding SubModes}" 
                      SelectedItem="{Binding SelectedSubMode}"
                      DisplayMemberPath="Description"/>
            
            <!-- Подрежим 2.2: Выбор уровня -->
            <StackPanel Margin="0,10" 
                        Visibility="{Binding SelectedSubMode.Type, Converter={StaticResource VisibilityConverter}, ConverterParameter=SubMode2}">
                <Label Content="Уровень отрисовки:"/>
                <ComboBox ItemsSource="{Binding Levels}" SelectedItem="{Binding SelectedLevelForDrawing}" DisplayMemberPath="Name"/>
            </StackPanel>

            <Button Content="Выбрать пространства" Margin="0,10"
                    Command="{Binding PickSpacesCommand}"/>
        </StackPanel>
            <!-- Сообщение о результате -->
            <TextBlock Grid.Row="5" Margin="0,10"
                       Text="{Binding Message}"
                       Foreground="{Binding MessageColor}"
                       HorizontalAlignment="Center"
                       FontSize="14"/>
        <!-- Кнопка создания -->
        <Button Content="Создать" Grid.Row="6" Command="{Binding DrawEnclosureCommand}" Width="120"/>
    </Grid>
</Window>