<Window x:Class="HVACLoadTerminals.HeatLoss.DrawNewSpaceFaces.Walls.WallOrientationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Отрисовка Стен" Height="350" Width="450" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#F0F0F0"
        FontFamily="Segoe UI"
        FontSize="14"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HVACLoadTerminals;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Выберите направление стены:" 
                   Grid.Row="0"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1">
            <RadioButton x:Name="UpButton" Content="Вверх" GroupName="Direction" Margin="0,0,0,5"/>
            <RadioButton x:Name="DownButton" Content="Вниз" GroupName="Direction" Margin="0,0,0,5"/>
            <RadioButton x:Name="LeftButton" Content="Влево" GroupName="Direction" Margin="0,0,0,5"/>
            <RadioButton x:Name="RightButton" Content="Вправо" GroupName="Direction" Margin="0,0,0,5"/>
        </StackPanel>

        <TextBlock Text="Выберите связанный документ:" 
                   Grid.Row="2"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,15,0,5"/>

        <ComboBox x:Name="DocumentComboBox" 
                  DisplayMemberPath="Title" 
                  SelectionChanged="DocumentComboBox_SelectionChanged"
                  Grid.Row="3"/>

        <StackPanel Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Grid.Row="4"
                    Margin="0,20,0,0">
            <Button x:Name="OkButton" Content="OK" 
                    Width="80" 
                    Margin="0,0,10,0" 
                    Click="OkButton_Click"/>
            <Button x:Name="CancelButton" Content="Отмена" 
                    Width="80" 
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>