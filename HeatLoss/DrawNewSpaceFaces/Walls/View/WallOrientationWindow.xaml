<Window x:Class="HVACLoadTerminals.HeatLoss.DrawNewSpaceFaces.Walls.View.WallOrientationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HVACLoadTerminals.HeatLoss.DrawNewSpaceFaces.Walls"
        xmlns:conv="clr-namespace:HVACLoadTerminals.HeatLoss.DrawNewSpaceFaces.Walls.View.Converters"
        Title="Отрисовка стен"
        Height="1000"
        Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#F0F0F0">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:InverseBoolConverter x:Key="InverseBool"/>
        <conv:BoolToCollapsedConverter x:Key="BoolToCollapsed"/>
        <conv:StringEqualsConverter x:Key="StringEqualsConverter"/>
        <conv:GreaterThanZeroConverter x:Key="GreaterThanZeroConverter"/>
        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#0078D4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}" 
                                   TextDecorations="Underline"
                                   Padding="{TemplateBinding Padding}"
                                   Foreground="{TemplateBinding Foreground}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition />
        </Grid.RowDefinitions>

        <!-- Выбор направления -->
        <TextBlock Text="Выберите направление Севера:" Grid.Row="0"/>
        <StackPanel Grid.Row="1">
            <RadioButton Content="Вверх" 
                       IsChecked="{Binding SelectedDirection,
                        Converter={StaticResource StringEqualsConverter}, ConverterParameter=up}"/>
            <RadioButton Content="Вниз" 
                       IsChecked="{Binding SelectedDirection, 
                       Converter={StaticResource StringEqualsConverter}, ConverterParameter=down}"/>
            <RadioButton Content="Влево" 
                       IsChecked="{Binding SelectedDirection,
                        Converter={StaticResource StringEqualsConverter}, ConverterParameter=left}"/>
            <RadioButton Content="Вправо" 
                       IsChecked="{Binding SelectedDirection, 
                       Converter={StaticResource StringEqualsConverter}, ConverterParameter=right}"/>
        </StackPanel>
        
        <!-- Выбор документа -->
        <TextBlock Grid.Row="2" 
                   Text="Связанный документ:" 
                   Margin="0 0 0 5"/>
        <ComboBox Grid.Row="3"
                  ItemsSource="{Binding DocumentService.LinkedDocuments}"
                  SelectedItem="{Binding SelectedRoomDocument}"
                  DisplayMemberPath="Title"
                  Margin="0 0 0 10"/>

        <!-- Выбор уровня -->
        <TextBlock Grid.Row="4" 
                   Text="Уровень земли:" 
                   Margin="0 0 0 5"/>
        <ComboBox Grid.Row="5"
                  ItemsSource="{Binding DocumentService.GroundLevels}"
                  DisplayMemberPath="Name"
                  SelectedItem="{Binding SelectedGroundLevel}"
                  Margin="0 0 0 15"/>

        <!-- Режим работы -->
        <StackPanel Grid.Row="6" Orientation="Vertical">
            <RadioButton Content="Автоматический режим" 
                       IsChecked="{Binding UseAutoMode}"
                       GroupName="Mode"/>
            <RadioButton Content="Ручной выбор типов стен" 
                       IsChecked="{Binding UseAutoMode, 
                       Converter={StaticResource InverseBool}}"
                       GroupName="Mode"
                       Margin="0 5 0 0"/>
        </StackPanel>

        <!-- Список типов стен -->
        <Border Grid.Row="7" 
                Visibility="{Binding UseAutoMode, 
                Converter={StaticResource BoolToCollapsed}}"
                Margin="0 10 0 15"
                Background="White"
                Padding="10"
                CornerRadius="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <CheckBox Content="Выбрать все"
                          IsChecked="{Binding AllTypesSelected, Mode=TwoWay}"
                          Checked="SelectAll_Checked"
                          Unchecked="SelectAll_Unchecked"
                          Margin="0 5"/>
                
                <ScrollViewer Grid.Row="1" 
                              VerticalScrollBarVisibility="Auto" 
                              Margin="0 10 0 0">
                    <ItemsControl ItemsSource="{Binding AvailableWallTypes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Type.Name}" 
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          Margin="4 2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                
                <Button Grid.Row="2"
                        Content="Повторить неудачные" 
                        Command="{Binding RetryFailedWallsCommand}"
                        Margin="0 10 0 0"
                        IsEnabled="{Binding FailedWallsCount,
                         Converter={StaticResource GreaterThanZeroConverter}}"/>
            </Grid>
        </Border>

        <!-- Статистика -->
        <StackPanel Grid.Row="8" 
                   Orientation="Horizontal" 
                   HorizontalAlignment="Center"
                   Margin="0 10 0 5">
            <TextBlock Text="Успешно: " FontWeight="Bold"/>
            <TextBlock Text="{Binding CreatedWallsCount}"
                       Foreground="Green" Margin="5 0"/>
            
            <TextBlock Text="Неудачно: " 
                       FontWeight="Bold" 
                       Margin="10 0 0 0"/>
            <TextBlock Text="{Binding FailedWallsCount}" 
                       Foreground="Red" 
                       Margin="5 0"/>
        </StackPanel>

        <!-- Список ошибок -->
        <Border Grid.Row="9" 
                Visibility="{Binding FailedWallsCount, 
                Converter={StaticResource GreaterThanZeroConverter}}"
                Background="#FFF0F0"
                Margin="0 5 0 10"
                Padding="10"
                CornerRadius="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <TextBlock Text="Ошибки:" 
                           FontWeight="Bold" 
                           Margin="0 0 0 5"/>
                
                <ListBox Grid.Row="1" 
                         ItemsSource="{Binding ErrorMessages}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         MaxHeight="150"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" 
                                     Foreground="DarkRed" 
                                     TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Панель управления -->
        <StackPanel Grid.Row="10" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Margin="0 15 0 0">
            <Button Content="Отрисовать" 
                    Command="{Binding OkCommand}"
                    Width="120"
                    Margin="0 0 10 0"/>
            
            <Button Content="Обновить" 
                    Command="{Binding RefreshCacheCommand}"
                    Width="120"/>
            
            <Button Content="Закрыть" 
                    x:Name="CancelButton"
                    Width="120"/>
        </StackPanel>

        <!-- Статус -->
        <TextBlock Grid.Row="11"
                   Text="{Binding StatusMessage}"
                   Foreground="{Binding StatusColor}"
                   HorizontalAlignment="Center"
                   Margin="0 10 0 0"/>
        <!-- Новый блок после списка ошибок -->
        <Border Grid.Row="9" 
                Visibility="{Binding FailedWallsCount, Converter={StaticResource GreaterThanZeroConverter}}"
                Background="#FFF8F8"
                Margin="0 5 0 10"
                Padding="10"
                CornerRadius="5">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          MaxHeight="250">
                <StackPanel>
                    <TextBlock Text="Пространства с ошибками:" 
                               FontWeight="Bold" 
                               Margin="0 0 0 5"/>
            
                    <ItemsControl ItemsSource="{Binding FailedSpacesInfo}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0 3">
                                    <TextBlock Text="{Binding SpaceName}" Margin="0 0 5 0"/>
                                    <TextBlock Text="Ошибок: " Foreground="DarkRed"/>
                                    <TextBlock Text="{Binding FailedFacesCount}" Margin="0 0 10 0"/>
                            
                                    <Button Content="Показать" 
                                            Command="{Binding DataContext.ZoomToSpaceCommand, 
                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Location}"
                                            Padding="5 2"
                                            Style="{StaticResource LinkButtonStyle}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>