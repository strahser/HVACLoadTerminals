<Window x:Class="HVACLoadTerminals.HeatLoss.DrawNewSpaceFaces.Walls.View.WallOrientationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HVACLoadTerminals.HeatLoss.DrawNewSpaceFaces.Walls"
        xmlns:conv="clr-namespace:HVACLoadTerminals.HeatLoss.DrawNewSpaceFaces.Walls.View"
        Title="Отрисовка стен"
        Height="800"
        Width="600"
        WindowStartupLocation="CenterScreen"
        Background="#F0F0F0">
    
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:InverseBoolConverter x:Key="InverseBool"/>
        <conv:BoolToCollapsedConverter x:Key="BoolToCollapsed"/>
        <conv:StringEqualsConverter x:Key="StringEqualsConverter"/>
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Выбор направления -->
        <TextBlock Text="Выберите направление Севера:" Grid.Row="0"/>
        <StackPanel Grid.Row="1">
            <RadioButton Content="Вверх" IsChecked="{Binding SelectedDirection, Converter={StaticResource StringEqualsConverter}, ConverterParameter=up}"/>
            <RadioButton Content="Вниз" IsChecked="{Binding SelectedDirection, Converter={StaticResource StringEqualsConverter}, ConverterParameter=down}"/>
            <RadioButton Content="Влево" IsChecked="{Binding SelectedDirection, Converter={StaticResource StringEqualsConverter}, ConverterParameter=left}"/>
            <RadioButton Content="Вправо" IsChecked="{Binding SelectedDirection, Converter={StaticResource StringEqualsConverter}, ConverterParameter=right}"/>
        </StackPanel>
        
        <!-- Выбор документа -->
        <TextBlock Grid.Row="2" 
                   Text="Связанный документ:" 
                   Margin="0 0 0 5"/>
        <ComboBox Grid.Row="3"
                  ItemsSource="{Binding DocumentService.LinkedDocuments}"
                  SelectedItem="{Binding SelectedRoomDocument}"
                  DisplayMemberPath="Title"
                  Margin="0 0 0 10"/>

        <!-- Выбор уровня -->
        <TextBlock Grid.Row="4" 
                   Text="Уровень земли:" 
                   Margin="0 0 0 5"/>
        <ComboBox Grid.Row="5"
                  ItemsSource="{Binding DocumentService.GroundLevels}"
                  DisplayMemberPath="Name"
                  SelectedItem="{Binding SelectedGroundLevel}"
                  Margin="0 0 0 15"/>

        <!-- Режим работы -->
        <StackPanel Grid.Row="6" Orientation="Vertical">
            <RadioButton Content="Автоматический режим" 
                       IsChecked="{Binding UseAutoMode}"
                       GroupName="Mode"/>
            <RadioButton Content="Ручной выбор типов стен" 
                       IsChecked="{Binding UseAutoMode, 
                       Converter={StaticResource InverseBool}}"
                       GroupName="Mode"
                       Margin="0 5 0 0"/>
        </StackPanel>

        <!-- Список типов стен -->
        <Border Grid.Row="7" 
                Visibility="{Binding UseAutoMode, 
                Converter={StaticResource BoolToCollapsed}}"
                Margin="0 10 0 15"
                Background="White"
                Padding="10"
                CornerRadius="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <CheckBox Content="Выбрать все"
                          IsChecked="{Binding AllTypesSelected, Mode=TwoWay}"
                          Visibility="{Binding UseAutoMode, Converter={StaticResource InverseBool}}"
                          Checked="SelectAll_Checked"
                          Unchecked="SelectAll_Unchecked"/>
                
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" 
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="0 10 0 0">
                    <ItemsControl ItemsSource="{Binding AvailableWallTypes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Type.Name}" 
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          Checked="CheckBox_Checked"
                                          Unchecked="CheckBox_Checked"
                                          Margin="4 2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Панель управления -->
        <StackPanel Grid.Row="8" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Margin="0 15 0 0">
            <Button Content="Отрисовать" 
                    Command="{Binding OkCommand}"
                    Width="120"
                    Margin="0 0 10 0"/>
            
            
            <Button Content="Обновить" 
                    Command="{Binding RefreshCacheCommand}"
                    Width="120"/>
            <Button Content="Закрыть" 
                    x:Name="CancelButton"
                    Width="120"/>
        </StackPanel>

        <!-- Информация -->
        <TextBlock Grid.Row="9"
                   Text="{Binding WallCountInfo}"
                   Foreground="Green"
                   HorizontalAlignment="Center"
                   Margin="0 10 0 0"/>
    </Grid>
</Window>