<UserControl x:Class="HVACLoadTerminals.HeatLoss.DrawNewSpaceFaces.MainDrawControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:drawNewSpaceFaces="clr-namespace:HVACLoadTerminals.HeatLoss.DrawNewSpaceFaces">
    <UserControl.DataContext>
        <drawNewSpaceFaces:MainDrawViewModel />
    </UserControl.DataContext>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HVACLoadTerminals;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <StackPanel Margin="20">
            <Button Command="{Binding DrawWallsCommand}" 
                    Content="Нарисовать стены" 
                    Margin="0,0,0,10"

                    />
            <Button Command="{Binding DrawWindowsAndDoorsCommand}" 
                    Content="Нарисовать окна и двери" 
                    Margin="0,0,0,10"

                    />
            <Button Command="{Binding DrawFloorsCommand}" 
                    Content="Нарисовать перекрытия" 
                    Margin="0,0,0,10"
                    Style="{StaticResource DrawFloorsButtonStyle}"/>
            <Button Command="{Binding DrawDirectShapeCommand}" 
                    Content="Создать энергетическую модель" 
                    Margin="0,0,0,10"

                    />
        </StackPanel>
    </Grid>
</UserControl>