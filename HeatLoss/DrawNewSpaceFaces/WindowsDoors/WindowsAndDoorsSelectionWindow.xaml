<Window x:Class="HVACLoadTerminals.HeatLoss.DrawNewSpaceFaces.WindowsDoors.WindowsAndDoorsSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Создать окна/двери"
        Height="300"
        Width="400"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F0F0F0"
        FontFamily="Segoe UI"
        FontSize="14"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HVACLoadTerminals;component/Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Выберите связанный документ:"
                   Grid.Row="0"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,5" />

        <ComboBox x:Name="DocumentComboBox"
                  DisplayMemberPath="Title"
                  ItemsSource="{Binding LinkedDocuments}"
                  SelectedItem="{Binding SelectedRoomDocument}"
                  Grid.Row="1" />

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Grid.Row="2"
                    Margin="0,15,0,0">
            <Button Command="{Binding DrawWindowsCommand}"
                    Content="Создать окна"
                    Width="120"
                    Margin="0,0,10,0"
                    Style="{StaticResource {x:Type Button}}"/> <!-- Apply default Button style -->
            <Button Command="{Binding DrawDoorsCommand}"
                    Content="Создать двери"
                    Width="120"
                    Style="{StaticResource {x:Type Button}}"/> <!-- Apply default Button style -->
        </StackPanel>

        <Button x:Name="CancelButton"
                Content="Отмена"
                Width="80"
                HorizontalAlignment="Right"
                Grid.Row="3"
                Margin="0,20,0,0"
                Click="CancelButton_Click"
                Style="{StaticResource {x:Type Button}}"/> <!-- Apply default Button style -->
    </Grid>
</Window>