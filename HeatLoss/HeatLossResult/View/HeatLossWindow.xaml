<Window x:Class="HVACLoadTerminals.HeatLoss.HeatLossResult.View.HeatLossWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:data="clr-namespace:System.Windows.Data;assembly=PresentationFramework"
             xmlns:heatLossResult="clr-namespace:HVACLoadTerminals.HeatLoss.HeatLossResult"
             d:DataContext="{d:DesignInstance Type=heatLossResult:HeatLossTableViewModel}"
             mc:Ignorable="d"
             Title="Теплопотери помещений"
             Height="600"
             Width="900"
             WindowStartupLocation="CenterScreen"
             FontFamily="Segoe UI"
             FontSize="14"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Auto"
             Background="#F0F0F0"
             WindowState="Maximized"> 

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HVACLoadTerminals;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- DataGrid Styles -->
            <Style TargetType="DataGrid">
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="#CCCCCC"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="RowHeight" Value="30"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="AlternatingRowBackground" Value="#F9F9F9"/>
            </Style>
            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="#E0E0E0"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="Padding" Value="5"/>
            </Style>
            <Style TargetType="DataGridCell">
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="5"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <!-- Коллекция с группировкой -->
            <CollectionViewSource x:Key="GroupedData" Source="{Binding FaceDataList}">
                <CollectionViewSource.GroupDescriptions>
                    <PropertyGroupDescription PropertyName="SpaceNumber"/>
                </CollectionViewSource.GroupDescriptions>
            </CollectionViewSource>
            <!-- Стиль для Expander в заголовке группы -->
            <Style x:Key="GroupHeaderStyle" TargetType="GroupItem">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GroupItem">
                            <!-- Expander растягивается на всю ширину -->
                            <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                      Background="#E0E0E0"
                                      Margin="0,2"
                                      HorizontalContentAlignment="Stretch">
                    
                                <Expander.Header>
                                    <!-- Grid занимает всю ширину -->
                                    <Grid>
                 <!-- Текст выравнивается по правому краю -->
                                        <TextBlock HorizontalAlignment="Right"
                                                   Margin="5,0">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="Теплопотери помещения {0} (Итого: {1} Вт) Количество конструкций {2}">
                                                    <Binding Path="Name"/>
                                                    <Binding Path="Items[0].Subtotal"/>
                                                    <Binding Path="Items.Count"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Grid>
                                </Expander.Header>

                                <!-- Контент группы -->
                                <ItemsPresenter/>
                            </Expander>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
        
    </Window.Resources>

    <Grid>
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="20,10,20,10">
                <TextBlock Text="Теплотехнический расчет"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10"/>
                <!-- Consider adding a ComboBox/RadioButtons here for North direction -->
                <Button Command="{Binding RecalculateDataCommand}"
                        Content="Пересчитать Данные"
                        Padding="10,5"
                        Margin="0,0,0,10"
                        Style="{StaticResource {x:Type Button}}"/>
                
                <Button Command="{Binding SetRoomHeatLoadsCommand}"
                        Content="Установить теплопотери в пространства"
                        Padding="10,5"
                        Margin="0,0,0,10"
                        Style="{StaticResource {x:Type Button}}"/>
                
                <Button Command="{Binding SetSurfaceHeatLoadsCommand}"
                        Content="Установить расчетные значения в поверхности"  
                        Padding="10,5"
                        Margin="0,0,0,10"
                        Style="{StaticResource {x:Type Button}}"/>  

                <Button Command="{Binding ExportToDocxCommand}"
                        Content="Экспортировать в DOCX"  
                        Padding="10,5"
                        Margin="0,0,0,10"
                        Style="{StaticResource {x:Type Button}}"/>  
                
            </StackPanel>
            <!--~1~ Панель управления @1@
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10">
                <Button Content="Показать все" 
                        Command="{Binding ExpandAllCommand}"
                        Margin="5" Padding="10"/>
                <Button Content="Скрыть все" 
                        Command="{Binding CollapseAllCommand}"
                        Margin="5" Padding="10"/>
            </StackPanel>-->
            <ScrollViewer DockPanel.Dock="Bottom"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <DataGrid x:Name="MainDataGrid"
                          ItemsSource="{Binding Source={StaticResource GroupedData}}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserSortColumns="True"
                          GridLinesVisibility="Vertical"
                          HeadersVisibility="Column"
                          ColumnWidth="Auto"
                >
                            
                    <DataGrid.GroupStyle>
                        <GroupStyle ContainerStyle="{StaticResource GroupHeaderStyle}"/>
                    </DataGrid.GroupStyle>

                </DataGrid>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>