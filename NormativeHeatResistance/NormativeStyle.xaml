<!-- Стиль группировки чек боксов для конструкций -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Style x:Key="GroupHeaderStyle" TargetType="GroupItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupItem">
                    <Expander IsExpanded="True" Background="#FFE0E0E0" Margin="0,2">
                        <Expander.Header>
                            <DockPanel>
                                <CheckBox IsChecked="{Binding IsGroupChecked, Mode=TwoWay}"
                                          Command="{Binding DataContext.UpdateGroupCheckBoxStateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                          CommandParameter="{Binding Name}"
                                          Margin="5,0"/>
                                <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding ItemCount}" Margin="10,0" Foreground="DarkBlue"/>
                            </DockPanel>
                        </Expander.Header>
                        <ItemsPresenter/>
                    </Expander>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <CollectionViewSource x:Key="GroupedElements" Source="{Binding EnclosureElements}">
        <CollectionViewSource.GroupDescriptions>
            <PropertyGroupDescription PropertyName="EnclosureType"/>
        </CollectionViewSource.GroupDescriptions>
    </CollectionViewSource>

                    
</ResourceDictionary>