<Window x:Class="HVACLoadTerminals.NormativeHeatResistance.NormativeHeatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:normativeHeatResistance="clr-namespace:HVACLoadTerminals.NormativeHeatResistance"
        Title="Нормативное сопротивление" Height="450" Width="600"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <normativeHeatResistance:NormativeHeatViewModel/>
    </Window.DataContext>

    <Grid Margin="10">
        <StackPanel>
            <ComboBox ItemsSource="{Binding BuildingCategories}"
                      SelectedItem="{Binding SelectedCategory}"

                      Margin="0,0,0,10"/>

            <DataGrid ItemsSource="{Binding EnclosureElements}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Тип" Binding="{Binding EnclosureType}"/>
                    <DataGridTextColumn Header="R0 норм." Binding="{Binding NormativeTransferCoefficient}"/>
                    <DataGridTemplateColumn Header="Исп. норматив">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding UseNormative}" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Grid>
</Window>