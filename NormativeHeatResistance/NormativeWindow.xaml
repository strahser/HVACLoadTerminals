<Window x:Class="HVACLoadTerminals.NormativeHeatResistance.NormativeHeatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:normativeHeatResistance="clr-namespace:HVACLoadTerminals.NormativeHeatResistance"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        Title="Нормативное сопротивление" Height="500" Width="800"
        WindowStartupLocation="CenterScreen">
    
    <Window.DataContext>
        <normativeHeatResistance:NormativeHeatViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <CollectionViewSource x:Key="GroupedElements" Source="{Binding EnclosureElements}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="EnclosureType"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <Style x:Key="GroupHeaderStyle" TargetType="GroupItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupItem">
                        <Expander IsExpanded="True" Background="#FFE0E0E0" Margin="0,2">
                            <Expander.Header>
                                <DockPanel>
                                    <CheckBox IsChecked="{Binding DataContext.IsGroupChecked, RelativeSource={RelativeSource AncestorType=Window}}"
                                              Command="{Binding DataContext.UpdateGroupCheckBoxStateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                              CommandParameter="{Binding Name}"
                                              Margin="5,0"/>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding ItemCount}" Margin="10,0" Foreground="DarkBlue"/>
                                </DockPanel>
                            </Expander.Header>
                            <ItemsPresenter/>
                        </Expander>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <StackPanel>
            <ComboBox ItemsSource="{Binding BuildingCategories}"
                      SelectedItem="{Binding SelectedCategory}"
                      Margin="0,0,0,10"
                      />

            <Button Content="Обновить поверхности" 
                    Command="{Binding UpdateSurfacesCommand}"
                    Width="150" 
                    HorizontalAlignment="Left"
                    Margin="0,0,0,10"/>

            <Button Content="Закрыть окно" 
                    Click="CloseWindow_Click"
                    Width="100"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,10"/>

            <CheckBox Content="Применить ко всем"
                      IsChecked="{Binding MasterCheckBoxState}"
                      HorizontalAlignment="Right"
                      Margin="0,0,0,10"/>

            <DataGrid ItemsSource="{Binding Source={StaticResource GroupedElements}}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      EnableRowVirtualization="True">
                
                <DataGrid.GroupStyle>
                    <GroupStyle ContainerStyle="{StaticResource GroupHeaderStyle}"/>
                </DataGrid.GroupStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Конструкция" 
                                      Binding="{Binding ConstructionType}"
                                      Width="*"/>
                    <DataGridTextColumn Header="Сокращение" 
                                      Binding="{Binding ShortConstructionName}"
                                      Width="120"/>
                    <DataGridTextColumn Header="K факт." 
                                      Binding="{Binding TransferCoefficient, StringFormat=F2}"
                                      Width="80"/>
                    <DataGridTextColumn Header="K норм." 
                                      Binding="{Binding NormativeTransferCoefficient, StringFormat=F2}"
                                      Width="80"
                                      IsReadOnly="True"/>
                    <DataGridTextColumn Header="R0 норм." 
                                      Binding="{Binding NormativeTransferThermalCoefficient, StringFormat=F2}"
                                      Width="80"
                                      IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="Использовать" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding UseNormative, Mode=TwoWay}"
                                          HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBox Text="{Binding UpdateSummary}"
                     IsReadOnly="True"
                     Height="100"
                     Margin="0,10"
                     VerticalScrollBarVisibility="Auto"/>
        </StackPanel>
    </Grid>
</Window>